---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="container">
    <div class="top">
      <div class="photo" data-reveal>
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 840]}
          sizes="(max-width: 47.99rem) 60vw, 400px"
          alt="Wilfred Chetat, smiling, in a navy blazer and white shirt"
          loading="lazy"
        />
      </div>
      <div class="bio" data-reveal style="--i: 1">
        <h2 id="about-title" class="display">About</h2>
        <p class="lead">
          My work spans payment and wallet systems, data ingestion and video analytics. I build the backends, and the
          interfaces and integrations that turn them into usable products.
        </p>
        <p class="lead">
          Alongside employed roles, I take on freelance client work. I built EduClick end to end as a volunteer, and
          Intrvuer as my own product.
        </p>
      </div>
    </div>

    <div class="details">
      <div data-reveal>
        <h3>Experience</h3>
        <table class="experience">
          <caption class="visually-hidden">Experience, most recent first</caption>
          <tbody>
            {
              site.experience.map((e) => (
                <tr>
                  <th scope="row">
                    <span class="company">{e.company}</span>
                    <span class="role">{e.role}</span>
                  </th>
                  <td class="dates">{e.dates}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <a class="link-ink cv" href={site.links.cv}>Full history in my CV (PDF) <Icon name="arrow-up-right" /></a>
      </div>
      <div data-reveal style="--i: 1">
        <h3>What I work with</h3>
        <dl class="stack">
          {
            site.stack.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd>{s.tools}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about > .container {
    padding-block: var(--section);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    align-items: end;
    gap: 32px clamp(2.5rem, 0.5rem + 4vw, 5rem);
  }

  .photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  h2 {
    font-size: var(--text-h2);
  }

  .lead {
    max-width: 34em;
    margin-top: 20px;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--muted);
  }

  h2 + .lead {
    margin-top: 24px;
    color: var(--ink);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px clamp(2.5rem, 0.5rem + 4vw, 5rem);
    margin-top: clamp(3.5rem, 2.6rem + 3.7vw, 6rem);
  }

  h3 {
    font-size: var(--text-lead);
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  /* a real table: one row per role, ruled between rows */
  .experience {
    width: 100%;
    margin-top: 12px;
    border-collapse: collapse;
  }

  .experience tr + tr > * {
    border-top: 1px solid var(--line);
  }

  .experience th {
    padding: 16px 16px 16px 0;
    font-weight: 400;
    text-align: left;
    vertical-align: top;
  }

  .company {
    display: block;
    font-weight: 600;
  }

  .role {
    display: block;
    margin-top: 2px;
    font-size: 16px;
    color: var(--muted);
  }

  .dates {
    padding: 16px 0;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-align: right;
    vertical-align: top;
    white-space: nowrap;
  }

  .cv {
    margin-top: 8px;
    font-size: 16px;
  }

  .stack {
    display: grid;
    gap: 22px;
    margin-top: 20px;
  }

  .stack dt {
    font-weight: 600;
  }

  .stack dd {
    margin-top: 4px;
    font-size: 16px;
    color: var(--muted);
  }

  @media (max-width: 63.99rem) {
    .details {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 47.99rem) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .photo :global(img) {
      aspect-ratio: 1 / 1;
    }

    .lead {
      font-size: 18px;
    }

    .experience tr {
      display: grid;
    }

    .experience th {
      padding: 14px 0 0;
    }

    .experience .dates {
      padding: 2px 0 14px;
      border-top: 0;
      font-size: 14px;
      text-align: left;
    }
  }
</style>
