---
import { site } from '../data/site';
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="container layout">
    <div class="col">
      <h2 id="about-title" class="display">About</h2>
      <p class="lead">
        My work spans payment and wallet systems, data ingestion and video analytics. I work mainly with Python, and
        I also build the interfaces and integrations needed to turn a backend into a usable product.
      </p>
      <p class="lead second">
        Alongside employed roles, I take on freelance client work, built Intrvuer, and contribute to EduClick’s
        opportunity-ingestion backend.
      </p>
      <!-- phones hide the at-a-glance strip, so its facts move here -->
      <dl class="facts">
        {
          site.glance.map((g) => (
            <div>
              <dt>{g.term}</dt>
              <dd>{g.detail}</dd>
            </div>
          ))
        }
      </dl>
      <h3 class="eyebrow stack-title">What I work with</h3>
      <dl class="stack">
        {
          site.stack.map((s) => (
            <div>
              <dt>{s.area}</dt>
              <dd>{s.tools}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="col">
      <h3 class="eyebrow exp-title">Experience</h3>
      <ol class="experience">
        {
          site.experience.map((e) => (
            <li>
              <div class="row">
                <span class="company">{e.company}</span>
                <span class="dates">{e.dates}</span>
              </div>
              <div class="role">{e.role}</div>
            </li>
          ))
        }
      </ol>
      <p class="cv"><a href={site.links.cv}>Full history in my CV (PDF)</a></p>
    </div>
  </div>
</section>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    padding-block: clamp(3rem, 1.886rem + 4.571vw, 6rem);
  }

  .col {
    flex: 1 1 420px;
    min-width: 0;
  }

  .col + .col {
    flex-basis: 380px;
  }

  h2 {
    font-size: clamp(1.875rem, 1.643rem + 0.952vw, 2.5rem);
    line-height: 1.15;
  }

  .lead {
    max-width: 34em;
    margin-top: 24px;
  }

  .lead.second {
    margin-top: 18px;
  }

  .facts {
    display: none;
  }

  .eyebrow {
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stack-title {
    margin-top: 44px;
  }

  .exp-title {
    margin-top: 12px;
  }

  .stack {
    border-top: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.5;
  }

  .stack div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .stack dt {
    flex: 0 0 190px;
    font-weight: 500;
  }

  .stack dd {
    flex: 1 1 240px;
    color: var(--muted);
  }

  .experience {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .experience li {
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .company {
    font-weight: 500;
  }

  .dates {
    font-size: 15px;
    color: var(--muted);
  }

  .role {
    font-size: 16px;
  }

  .cv {
    margin-top: 18px;
    font-size: 16px;
  }

  .cv a {
    display: inline-block;
    padding: 10px 0;
  }

  /* phone: facts, then experience, then the stack, as in the phone artboard */
  @media (max-width: 47.99rem) {
    .layout {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
    }

    .col {
      display: contents;
    }

    .lead {
      margin-top: 16px;
    }

    .lead.second {
      margin-top: 12px;
    }

    .facts {
      display: block;
      margin-top: 20px;
      border-top: 1px solid var(--line);
      font-size: 15px;
    }

    .facts div {
      padding-block: 10px;
      border-bottom: 1px solid var(--line);
    }

    .facts dt {
      font-size: 13px;
      color: var(--muted);
    }

    .eyebrow {
      margin-bottom: 10px;
      font-size: 13px;
    }

    .exp-title {
      order: 1;
      margin-top: 32px;
    }

    .experience {
      order: 2;
      font-size: 15px;
    }

    .experience li {
      padding-block: 12px;
    }

    .company {
      font-size: 16px;
    }

    .cv {
      order: 3;
      margin-top: 8px;
    }

    .stack-title {
      order: 4;
      margin-top: 32px;
    }

    .stack {
      order: 5;
      font-size: 15px;
    }

    .stack div {
      padding-block: 10px;
    }

    .stack dt {
      flex-basis: 100%;
    }

    .stack dd {
      flex-basis: 100%;
    }
  }
</style>
