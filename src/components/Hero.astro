---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import sampleReport from '../assets/captures/intrvuer/sample-report.png';
import practiceIos from '../assets/captures/intrvuer/spoken-practice-ios.png';
import { site } from '../data/site';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import Icon from './Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="split">
      <div class="copy">
        <h1 id="hero-title" class="display" data-reveal>Building reliable systems.</h1>
        <p class="lede" data-reveal style="--i: 1">
          I’m <span class="who"
            ><Picture
              src={portrait}
              formats={['avif', 'webp']}
              widths={[56, 112]}
              sizes="56px"
              alt=""
              loading="eager"
              class="avatar"
            />Wilfred Chetat</span
          >, a senior software engineer. For 7+ years I’ve built products in payments, data systems, video analytics
          and AI, and I took Intrvuer, my own product, from interface to deployment.
        </p>
        <div class="actions" data-reveal style="--i: 2">
          <a class="btn btn-primary" href="#work">View projects <Icon name="arrow-right" /></a>
          <a class="btn btn-secondary" href="#contact">Get in touch</a>
        </div>
        <ul class="profiles" aria-label="Profiles and CV" data-reveal style="--i: 2">
          <li><a class="link-ink" href={site.links.cv}>CV (PDF)</a></li>
          <li><a class="link-ink" href={site.links.github}>GitHub <Icon name="arrow-up-right" /></a></li>
          <li><a class="link-ink" href={site.links.linkedin}>LinkedIn <Icon name="arrow-up-right" /></a></li>
        </ul>
      </div>

      <figure class="showcase" data-reveal style="--i: 2">
        <div class="stage">
          <div class="desk">
            <BrowserFrame
              src={sampleReport}
              url="intrvuer.com/sample-report"
              alt="Intrvuer's public sample report: an overall score of 4.2 out of 5, a coach summary and a performance analysis across five dimensions."
              sizes="(max-width: 63.99rem) 92vw, 900px"
              eager
            />
          </div>
          <PhoneFrame
            class="device"
            src={practiceIos}
            alt="The Intrvuer iOS app during a spoken practice session, with the interviewer's question and the candidate's answer."
            sizes="(max-width: 47.99rem) 30vw, 220px"
            eager
          />
        </div>
        <figcaption>Intrvuer: the web sample report (fictional candidate) and the iOS practice session.</figcaption>
      </figure>
    </div>

    <dl class="glance" aria-label="At a glance">
      {
        site.glance.map((g, i) => (
          <div data-reveal style={`--i: ${i}`}>
            <dt>{g.term}</dt>
            <dd>{g.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* the stage bleeds past the right margin, so clip the page's edge, not the stage */
  .hero {
    overflow-x: clip;
  }

  .hero > .container {
    padding-block: clamp(2rem, 1.2rem + 3.3vw, 4rem) 0;
  }

  /* text on the left; the product, the larger half, on the right */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    align-items: center;
    gap: 40px clamp(2.5rem, 0.5rem + 4vw, 5rem);
  }

  h1 {
    font-size: clamp(2.5rem, 0.9rem + 4.6vw, 5rem); /* two lines in the text column */
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .lede {
    max-width: 34em;
    margin-top: clamp(1.25rem, 0.9rem + 1.4vw, 2rem);
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--muted);
  }

  .who {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .who :global(.avatar) {
    width: 1.5em;
    height: 1.5em;
    align-self: center;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    background: var(--surface);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
  }

  .actions .btn {
    min-height: 48px;
    padding-inline: 24px;
  }

  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: 10px 0 0;
    padding: 0 0 0 4px;
    list-style: none;
    font-size: 15px;
  }

  /*
   * The stage runs from the column's left edge to the viewport's right edge:
   * --edge is the distance from the container's content box to the screen edge.
   */
  .showcase {
    --edge: max(var(--gutter), (100vw - var(--content-max)) / 2);
    margin-right: calc(-1 * var(--edge));
  }

  .stage {
    position: relative;
    height: clamp(26rem, 14rem + 20vw, 37rem);
    padding: clamp(1.5rem, 0.6rem + 2.4vw, 3rem) 0 0 clamp(1.5rem, 0.6rem + 2.4vw, 3rem);
    overflow: hidden;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    background: var(--surface);
  }

  /* the browser starts a phone's width in, so the phone covers only its left edge */
  .desk {
    width: clamp(40rem, 20rem + 30vw, 58rem);
    margin-left: clamp(5rem, 1rem + 6vw, 8.5rem);
    overflow: hidden;
    border-radius: var(--radius) 0 0 0;
  }

  /* the phone stands whole on the stage's floor, over the browser's left edge, record button in view */
  .stage :global(.device) {
    position: absolute;
    left: clamp(1.25rem, 0.5rem + 1.2vw, 2rem);
    bottom: clamp(1rem, 0.6rem + 0.8vw, 1.75rem);
    width: clamp(8rem, 4rem + 8vw, 11.5rem);
    /* it overlaps the browser, so it floats above it */
    box-shadow: /* taste-skill-ignore */
      0 30px 60px -20px rgb(12 16 20 / 0.35),
      0 12px 24px -12px rgb(12 16 20 / 0.25);
  }

  figcaption {
    max-width: 34em;
    margin-top: 14px;
    font-size: var(--text-caption);
    color: var(--muted);
  }

  .glance {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 40px;
    margin-top: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
  }

  .glance dt {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .glance dd {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
  }

  /* below 64rem the stage moves under the text and sits inside the margins */
  @media (max-width: 63.99rem) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase {
      margin-right: 0;
    }

    .stage {
      height: clamp(18rem, 8rem + 40vw, 30rem);
      padding: clamp(1rem, 0.2rem + 3.3vw, 2.5rem) clamp(1rem, 0.2rem + 3.3vw, 2.5rem) 0;
      border-radius: var(--radius-lg);
    }

    .desk {
      width: 88%;
      margin-left: 0;
      border-radius: var(--radius) var(--radius) 0 0;
    }

    .stage :global(.device) {
      left: auto;
      right: clamp(1rem, -0.5rem + 4vw, 3rem);
      bottom: clamp(-5rem, -1rem - 3vw, -2rem);
      width: clamp(6.5rem, 3rem + 14vw, 12rem);
    }

    .glance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .lede {
      font-size: 18px;
    }

    .actions .btn {
      flex: 1 1 0;
      padding-inline: 12px;
    }

    .glance {
      gap: 20px 24px;
      margin-top: 40px;
    }
  }
</style>
