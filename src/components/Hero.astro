---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import sampleReport from '../assets/captures/intrvuer/sample-report.png';
import practiceIos from '../assets/captures/intrvuer/spoken-practice-ios.png';
import { site } from '../data/site';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import Icon from './Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <h1 id="hero-title" class="display" data-reveal>Building reliable systems.</h1>
    <div class="intro">
      <p class="lede" data-reveal style="--i: 1">
        I’m <span class="who"
          ><Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[56, 112]}
            sizes="56px"
            alt=""
            loading="eager"
            class="avatar"
          />Wilfred Chetat</span
        >, a senior software engineer in Dubai. I work mainly in Python on APIs, integrations, payments and data
        systems, and I built Intrvuer, my own product, from interface to deployment.
      </p>
      <div class="cta" data-reveal style="--i: 2">
        <div class="actions">
          <a class="btn btn-primary" href="#work">View projects <Icon name="arrow-right" /></a>
          <a class="btn btn-secondary" href="#contact">Get in touch</a>
        </div>
        <ul class="profiles" aria-label="Profiles and CV">
          <li><a class="link-ink" href={site.links.cv}>CV (PDF)</a></li>
          <li><a class="link-ink" href={site.links.github}>GitHub <Icon name="arrow-up-right" /></a></li>
          <li><a class="link-ink" href={site.links.linkedin}>LinkedIn <Icon name="arrow-up-right" /></a></li>
        </ul>
      </div>
    </div>

    <figure class="showcase" data-reveal style="--i: 3">
      <div class="stage">
      <div class="desk">
        <BrowserFrame
          src={sampleReport}
          url="intrvuer.com/sample-report"
          alt="Intrvuer's public sample report: an overall score of 4.2 out of 5, a coach summary and a performance analysis across five dimensions."
          sizes="(max-width: 47.99rem) 92vw, 1040px"
          eager
        />
      </div>
      <PhoneFrame
        class="device"
        src={practiceIos}
        alt="The Intrvuer iOS app during a spoken practice session, with the interviewer's question and the candidate's answer."
        sizes="(max-width: 47.99rem) 30vw, 250px"
        eager
      />
      </div>
      <figcaption>
        Intrvuer, my own product. The web sample report (fictional candidate) and the iOS practice session.
      </figcaption>
    </figure>

    <dl class="glance" aria-label="At a glance">
      {
        site.glance.map((g, i) => (
          <div data-reveal style={`--i: ${i}`}>
            <dt>{g.term}</dt>
            <dd>{g.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero > .container {
    padding-block: clamp(2.5rem, 1.6rem + 3.7vw, 5rem) 0;
  }

  h1 {
    font-size: var(--text-display);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 24px 64px;
    margin-top: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
  }

  .lede {
    max-width: 36em;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--muted);
  }

  .who {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .who :global(.avatar) {
    width: 1.5em;
    height: 1.5em;
    align-self: center;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    background: var(--surface);
  }

  .cta {
    justify-self: end;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .actions .btn {
    min-height: 48px;
    padding-inline: 24px;
  }

  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: 10px 0 0;
    padding: 0 0 0 4px;
    list-style: none;
    font-size: 15px;
  }

  /* the product stage: one tinted field, the web report bleeding off its foot, the phone in front */
  .showcase {
    margin-top: clamp(2.5rem, 1.9rem + 2.5vw, 4rem);
  }

  .stage {
    position: relative;
    padding: clamp(1rem, 0.2rem + 3.3vw, 3.5rem) clamp(1rem, 0.2rem + 3.3vw, 3.5rem) 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .desk {
    width: 84%;
    max-height: clamp(15rem, 6rem + 36vw, 38rem);
    overflow: hidden;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .stage :global(.device) {
    position: absolute;
    right: clamp(1rem, -0.5rem + 4vw, 4.5rem);
    bottom: clamp(-3rem, -0.5rem - 2vw, -1rem);
    width: clamp(6.5rem, 3rem + 14vw, 15.5rem);
    /* the phone overlaps the browser, so it floats above it */
    box-shadow: /* taste-skill-ignore */
      0 30px 60px -20px rgb(12 16 20 / 0.35),
      0 12px 24px -12px rgb(12 16 20 / 0.25);
  }

  figcaption {
    max-width: 34em;
    margin-top: clamp(1.5rem, 0.9rem + 2.4vw, 3.75rem);
    font-size: var(--text-caption);
    color: var(--muted);
  }

  .glance {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 40px;
    margin-top: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
  }

  .glance dt {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .glance dd {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
  }

  @media (max-width: 63.99rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .cta {
      justify-self: start;
    }

    .glance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    h1 {
      letter-spacing: -0.04em;
    }

    .lede {
      font-size: 18px;
    }

    .cta {
      width: 100%;
    }

    .actions .btn {
      flex: 1 1 0;
      padding-inline: 12px;
    }

    .desk {
      width: 88%;
    }

    .glance {
      gap: 20px 24px;
      margin-top: 40px;
    }

    .glance dd {
      font-size: 16px;
    }
  }
</style>
