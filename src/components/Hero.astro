---
import { site } from '../data/site';

const { hero } = site;
---

<section id="top" class="hero" data-hero>
  <canvas data-hero-canvas aria-hidden="true"></canvas>
  <div class="fade" aria-hidden="true"></div>
  <div class="inner">
    <p class="badge">
      <span class="pulse" aria-hidden="true"></span>
      <span>{hero.badge}</span>
    </p>
    <h1>
      <span class="lead">{hero.lead}</span>
      <span class="slot">
        <!-- the visible word rotates; readers of the page get the whole list once -->
        <span class="word" data-hero-word data-words={JSON.stringify(hero.words)} aria-hidden="true">{hero.words[0]}</span>
        <span class="visually-hidden">{hero.words.join(' ')}</span>
      </span>
    </h1>
    <p class="intro">{hero.intro}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#work">View projects</a>
      <a class="btn btn-secondary" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<script>
  import { startHeroCanvas } from '../scripts/hero-canvas';

  const section = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = section?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (section && canvas) startHeroCanvas(section, canvas);

  // the italic word changes every 2.4s, unless the visitor prefers reduced motion
  const word = document.querySelector<HTMLElement>('[data-hero-word]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (word) {
    const words: string[] = JSON.parse(word.dataset.words ?? '[]');
    let index = 0;
    window.setInterval(() => {
      if (still.matches || document.hidden || words.length < 2) return;
      index = (index + 1) % words.length;
      word.textContent = words[index];
      // restart the entrance
      word.style.animation = 'none';
      void word.offsetWidth;
      word.style.animation = '';
    }, 2400);
  }
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(56px, 9vw, 88px) var(--gutter) clamp(390px, calc(280px + 34vw), 540px);
    text-align: center;
    overflow: hidden;
  }

  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 140px;
    background: linear-gradient(transparent, var(--canvas));
    pointer-events: none;
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    max-width: 980px;
    margin-inline: auto;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-pill);
    background: rgb(7 5 13 / 0.5);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cfc8e2;
  }

  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: oklch(0.8 0.18 var(--h));
    animation: pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--white);
  }

  .lead,
  .slot {
    display: block;
  }

  .slot {
    min-height: 1.1em;
    font-style: italic;
    color: var(--accent-soft);
    text-shadow: 0 0 50px oklch(0.6 0.25 var(--h) / 0.7);
  }

  .word {
    display: inline-block;
    animation: wordin 0.6s ease both;
  }

  .intro {
    max-width: 620px;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.6;
    color: #c4bdd6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .actions .btn {
    padding: 14px 26px;
  }

  .actions .btn-secondary {
    background: rgb(7 5 13 / 0.5);
  }

  .actions .btn-secondary:hover {
    background: rgb(255 255 255 / 0.1);
    border-color: var(--line-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse,
    .word {
      animation: none;
    }
  }
</style>
