---
/* A rebuilt UI with example data: the chip sits in the frame, "Illustrative" goes in the caption too. */
import Label from './Label.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="frame" data-ui>
  <div class="head">
    <span class="title">{title}</span>
    <Label dashed>Illustrative reconstruction</Label>
  </div>
  <slot />
</div>

<style>
  .frame {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--white);
    font-size: 15px;
    line-height: 1.4;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 20px;
    background: #fafbfc;
  }

  .title {
    font-weight: 650;
  }

  @media (max-width: 47.99rem) {
    .frame {
      font-size: 14px;
    }

    .head {
      padding: 12px 14px;
    }
  }
</style>
