---
import ProjectFeature from './ProjectFeature.astro';
import IntrvuerShowcase from './IntrvuerShowcase.astro';
import BrowserFrame from './BrowserFrame.astro';
import UiReconstruction from './UiReconstruction.astro';
import ReconTable from './ReconTable.astro';
import Icon from './Icon.astro';
import opportunities from '../assets/captures/educlick/opportunities.png';
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="container">
    <h2 id="work-title" class="display section-title" data-reveal>Projects</h2>

    <article class="flagship" aria-labelledby="p1-title">
      <div class="flag-head">
        <div data-reveal>
          <h3 id="p1-title" class="display">Intrvuer</h3>
          <p class="one-liner">A voice interview coach that ties practice to the role you’re preparing for.</p>
          <p class="meta">
            <span class="live-dot" aria-hidden="true"></span><span class="live">Live</span>{' · '}Personal product
          </p>
        </div>
        <div data-reveal style="--i: 1">
          <p class="description">
            Candidates add a résumé and target job, answer questions out loud, and get feedback on each answer.
          </p>
          <p class="role">
            <span>My contribution: </span>design, Next.js web app, SwiftUI iOS app, FastAPI backend, speech and LLM
            integrations, deployment.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/work/intrvuer/">Read the case study <Icon name="arrow-right" /></a>
            <a class="link-ink" href="https://intrvuer.com/">Visit intrvuer.com <Icon name="arrow-up-right" /></a>
          </div>
        </div>
      </div>
      <IntrvuerShowcase />
    </article>

    <div class="rows">
      <ProjectFeature
        id="p2-title"
        title="EduClick"
        oneLiner="A platform that lists opportunities for African talent."
        kind="Volunteer project"
        detail="Public platform"
        live
        description="I built it end to end: the FastAPI backend, the Next.js frontend and the deployment. Its ingestion turns source listings into consistent records through per-record validation and replay-safe upserts, with an outcome for every record: created, updated or rejected."
      >
        <a slot="actions" class="link-ink" href="https://www.educlick.africa/opportunities"
          >Browse EduClick opportunities <Icon name="arrow-up-right" /></a
        >
        <Fragment slot="figure">
          <div class="edu">
            <BrowserFrame
              src={opportunities}
              url="educlick.africa/opportunities"
              alt="The EduClick opportunities page: a search bar with sorting and filters above listings that each show the organisation, location, posting date, deadline and a category."
              sizes="(max-width: 47.99rem) 88vw, 700px"
            />
            <div class="batch-card" data-ui>
              <p class="batch-title">Ingestion outcomes</p>
              <ul class="batch">
                <li><span>Scholarship · src-104</span><span class="status-ok">Created</span></li>
                <li><span>Internship · src-221</span><span class="status-fail">Rejected · no deadline</span></li>
                <li><span>Scholarship · src-104 again</span><span class="status-strong">Updated · no duplicate</span></li>
              </ul>
            </div>
          </div>
        </Fragment>
        <figcaption slot="caption">
          The live opportunities page, captured October 2026. The ingestion outcomes are an illustrative batch with fictional data; the labels follow the implementation.
        </figcaption>
      </ProjectFeature>

      <ProjectFeature
        id="p3-title"
        reverse
        title="Sysconnector"
        oneLiner="Facebook Lead Ads to Adobe Campaign, from webhook to sync status."
        kind="Freelance client project"
        detail="Upwork"
        description="I built the lead integration end to end: webhook processing, field mapping, sync status and connection validation, plus audience-management APIs and the React screens around them."
        roleLabel="My role"
        role="Freelance Full-Stack Engineer · Upwork"
      >
        <a slot="actions" class="btn btn-secondary" href="/work/sysconnector/"
          >Read the case study <Icon name="arrow-right" /></a
        >
        <Fragment slot="figure">
          <UiReconstruction title="Field mapping · Facebook Lead Ads → Adobe Campaign">
            <ReconTable
              columns={['Lead form field', 'Campaign field', 'Status']}
              rows={[
                ['full_name', '[Campaign field]', { text: 'Mapped', tone: 'ok' }],
                ['email', '[Campaign field]', { text: 'Mapped', tone: 'ok' }],
                ['phone_number', { text: 'Not mapped', tone: 'muted' }, { text: 'Needs a field', tone: 'fail' }],
              ]}
            />
            <p class="recon-note">Leads sync once required fields are mapped.</p>
          </UiReconstruction>
        </Fragment>
        <figcaption slot="caption">
          Illustrative reconstruction of the mapping step. Field names and labels are examples, not captured data.
        </figcaption>
      </ProjectFeature>

      <ProjectFeature
        id="p4-title"
        title="LeaseSurance"
        oneLiner="Lease insurance that replaces rental deposits, for residential and commercial portfolios."
        kind="Contract project"
        detail="Alphathesis · 2023–2024"
        description="As a contractor with Alphathesis, I built the backend: ingestion rules, the relational model, APIs, duplicate prevention and client-scoped access. Source files arrived with inconsistent periods, repeated transactions and running totals that couldn’t be trusted."
      >
        <Fragment slot="figure">
          <div class="ledger-card" data-ui>
            <table class="ledger">
              <caption class="visually-hidden">Derived period balance, sample data</caption>
              <tbody>
                <tr><th scope="row">Opening balance</th><td>1,200.00</td></tr>
                <tr><th scope="row">Accepted transactions</th><td>+ 230.00</td></tr>
                <tr class="status-muted"><th scope="row">Repeated ext-7781</th><td>skipped</td></tr>
                <tr class="total"><th scope="row">Derived period balance</th><td>1,430.00</td></tr>
              </tbody>
            </table>
          </div>
        </Fragment>
        <figcaption slot="caption">
          Sample data; the real data can’t be shown publicly. The balance comes from accepted transactions, and
          repeats are skipped.
        </figcaption>
      </ProjectFeature>
    </div>
  </div>
</section>

<style>
  .work > .container {
    padding-block: var(--section) 0;
  }

  .section-title {
    font-size: var(--text-h2);
  }

  .flagship {
    margin-top: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
  }

  .flag-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: end;
    gap: 24px clamp(2.5rem, 0.5rem + 4vw, 5rem);
  }

  h3 {
    font-size: var(--text-h1);
  }

  .one-liner {
    margin-top: 14px;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .meta {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .live {
    color: var(--ink);
    font-weight: 600;
  }

  .description {
    max-width: 38em;
    color: var(--muted);
  }

  .role {
    max-width: 38em;
    margin-top: 12px;
    font-size: 16px;
  }

  .role span {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin-top: 24px;
  }

  .rows {
    display: grid;
    gap: clamp(5rem, 3.5rem + 6vw, 9rem);
    margin-top: clamp(5rem, 3.5rem + 6vw, 9rem);
  }

  /* EduClick: the live page, with an ingestion batch resting on its corner */
  .edu {
    position: relative;
    width: 100%;
    padding-bottom: 56px;
  }

  .edu :global(.browser) {
    width: 92%;
  }

  .batch-card {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(78%, 400px);
    padding: 16px 18px 6px;
    border-radius: var(--radius);
    background: var(--white);
    /* this card overlaps the capture, so it floats above it */
    box-shadow: /* taste-skill-ignore */
      0 24px 48px -20px rgb(12 16 20 / 0.3),
      0 8px 16px -8px rgb(12 16 20 / 0.12);
    font-size: 15px;
    line-height: 1.4;
  }

  .batch-title {
    font-weight: 650;
  }

  .batch {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .batch li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 12px;
    padding: 9px 0;
  }

  /* rows inside an interface fragment (data-ui) */
  .batch li + li {
    border-top: 1px solid var(--line); /* taste-skill-ignore */
  }

  .recon-note {
    padding: 12px 20px 14px;
    font-size: 14px;
    color: var(--muted);
    background: #fafbfc;
  }

  .ledger-card {
    width: min(100%, 460px);
    padding: 10px 24px;
    border-radius: var(--radius);
    background: var(--white);
  }

  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }

  .ledger th {
    padding: 14px 0;
    font-weight: 400;
    text-align: left;
  }

  .ledger td {
    padding: 14px 0;
    text-align: right;
  }

  .ledger tr + tr > * {
    border-top: 1px solid var(--line);
  }

  .ledger .total > * {
    font-weight: 650;
  }

  @media (max-width: 63.99rem) {
    .flag-head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 47.99rem) {
    .description {
      font-size: 16px;
    }

    .edu {
      padding-bottom: 72px;
    }

    .edu :global(.browser) {
      width: 100%;
    }

    .batch-card {
      width: 92%;
      padding: 12px 14px 4px;
      font-size: 14px;
    }

    .ledger-card {
      padding: 6px 16px;
    }

    .ledger {
      font-size: 15px;
    }
  }
</style>
