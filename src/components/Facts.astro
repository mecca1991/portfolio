---
import { site } from '../data/site';
---

<section class="facts" aria-label="At a glance">
  <dl>
    {
      site.facts.map((fact) => (
        <div class="cell">
          <dt>{fact.term}</dt>
          <dd>{fact.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* the strip rides up over the foot of the hero */
  .facts {
    position: relative;
    margin-top: -60px;
    padding: 0 var(--gutter) var(--section);
  }

  /* 1px gaps over a hairline-coloured ground draw the dividers */
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 1px;
    max-width: var(--content-max);
    margin-inline: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    overflow: hidden;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--surface);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(0.78 0.15 var(--h));
  }

  dd {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
</style>
