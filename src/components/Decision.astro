---
interface Props {
  title: string;
  decision: string;
  tradeoff: string;
}

const { title, decision, tradeoff } = Astro.props;
---

<div class="decision" data-reveal>
  <h3>{title}</h3>
  <dl>
    <div>
      <dt>Decision</dt>
      <dd>{decision}</dd>
    </div>
    <div class="tradeoff">
      <dt>Tradeoff</dt>
      <dd>{tradeoff}</dd>
    </div>
  </dl>
</div>

<style>
  .decision {
    margin-top: 20px;
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .case-section > h2 + .decision {
    margin-top: 28px;
  }

  h3 {
    font-size: var(--text-lead);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  /* the decision and what it cost, side by side */
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px clamp(1.5rem, 0.8rem + 2vw, 2.5rem);
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.6;
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin-top: 6px;
    color: var(--muted);
  }

  .tradeoff dt {
    color: var(--attention);
  }

  @media (max-width: 47.99rem) {
    dl {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
