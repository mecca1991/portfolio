---
import { site } from '../data/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { DEMO_JSON, toTree } from '../scripts/json-tree';

const initial = toTree(DEMO_JSON);
---

<section id="lab" class="lab" aria-labelledby="lab-title">
  <div class="container">
    <SectionHead
      id="lab-title"
      kicker="GET /lab"
      title="Experiments and writing"
      sub="Smaller builds for learning and testing ideas."
    />
    <div class="grid">
      <article class="card" aria-labelledby="rust-title">
        <p class="tag">Personal project · Rust cohort</p>
        <h3 id="rust-title">Rust JSON Parser</h3>
        <p class="text">
          A custom tokenizer and parser supporting nested arrays and objects, typed JSON values, structured errors and
          formatting, developed with cohort feedback.
        </p>
        <div class="demo" data-json-demo>
          <div class="pane">
            <label class="pane-label" for="json-input">Input · edit me</label>
            <textarea id="json-input" spellcheck="false" autocomplete="off" autocapitalize="off" set:text={DEMO_JSON} />
          </div>
          <div class="pane">
            <span class="pane-label" id="json-output-label">Parsed structure</span>
            <pre
              tabindex="0"
              role="group"
              aria-labelledby="json-output-label"
              aria-live="polite"
              data-error={initial.error ? '' : undefined}>{initial.text}</pre>
          </div>
        </div>
        <p class="fine">
          This demo runs in your browser in JavaScript and imitates the output shape. The Rust parser is in the repo.
          Type names simplified.
        </p>
        <p class="links">
          <a href="/experiments/rust-json-parser/">How it works <Icon name="arrow-right" /></a>
          <a href="https://github.com/mecca1991/rust-cohort/tree/main/rust-json-parser"
            >View source <Icon name="arrow-up-right" /></a
          >
        </p>
      </article>

      <div class="column">
        <article class="card" aria-labelledby="poc-title">
          <p class="tag">Proof of concept</p>
          <h3 id="poc-title">Natural-language search over video detections</h3>
          <p class="text">
            Find a detection by describing clothing or belongings, using generated descriptions, text embeddings and
            Qdrant retrieval. I built the backend and search interface. Separate from production work.
          </p>
        </article>

        <article class="card writing" aria-labelledby="writing-title">
          <h3 class="tag accent" id="writing-title">Writing</h3>
          {
            site.writing.map((piece) => (
              <div class="piece">
                <p class="meta">{piece.meta}</p>
                <a class="title" href={piece.href}>
                  {piece.title} <Icon name="arrow-up-right" />
                </a>
                {piece.description && <p class="about">{piece.description}</p>}
              </div>
            ))
          }
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  import { toTree } from '../scripts/json-tree';

  const demo = document.querySelector<HTMLElement>('[data-json-demo]');
  const input = demo?.querySelector('textarea');
  const output = demo?.querySelector('pre');
  if (input && output) {
    const render = () => {
      const { text, error } = toTree(input.value);
      output.textContent = text;
      output.toggleAttribute('data-error', error);
    };
    input.addEventListener('input', render);
    render(); // the browser may have restored an edited value
  }
</script>

<style>
  .lab {
    padding-block: var(--section);
    scroll-margin-top: 60px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .writing {
    flex: 1;
    gap: 18px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cfc8e2;
  }

  .tag.accent {
    color: var(--accent-label);
  }

  h3:not(.tag) {
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }

  .demo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 10px;
  }

  .pane {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .pane-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  textarea,
  pre {
    width: 100%;
    height: 190px;
    margin: 0;
    padding: 14px;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.4);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
  }

  textarea {
    border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--ink);
    resize: vertical;
  }

  textarea:focus-visible {
    border-color: oklch(0.7 0.2 var(--h));
    outline-offset: 0;
  }

  pre {
    border: 1px solid rgb(255 255 255 / 0.07);
    color: oklch(0.88 0.1 var(--h));
    overflow: auto;
  }

  .fine {
    font-size: 12px;
    line-height: 1.6;
    color: var(--faint);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-top: auto;
    font-size: 14px;
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    text-decoration: none;
  }

  .links a + a {
    color: #cfc8e2;
  }

  .links a:hover {
    color: var(--white);
  }

  .piece {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .piece + .piece {
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .meta {
    font-size: 12px;
    color: var(--faint);
  }

  /* padded to a 44px target, pulled back so the spacing is unchanged */
  .title {
    margin-block: -11px;
    padding-block: 11px;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }

  .title:hover {
    color: oklch(0.85 0.14 var(--h));
  }

  .about {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
