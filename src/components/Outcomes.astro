---
interface Props {
  items: readonly { label: string; text: string }[];
}

const { items } = Astro.props;
---

<div class="outcomes">
  {
    items.map((o) => (
      <div class="outcome">
        <h3>{o.label}</h3>
        <p>{o.text}</p>
      </div>
    ))
  }
</div>

<style>
  .outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 24px;
  }

  .outcome {
    flex: 1 1 280px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }

  h3 {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  p {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.18rem + 0.286vw, 1.4375rem);
    line-height: 1.35;
  }

  @media (max-width: 47.99rem) {
    .outcomes {
      margin-top: 16px;
    }

    .outcome {
      padding-top: 10px;
    }

    h3 {
      font-size: 13px;
    }

    p {
      margin-top: 6px;
    }
  }
</style>
