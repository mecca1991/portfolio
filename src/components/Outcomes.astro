---
interface Props {
  items: readonly { label: string; text: string }[];
}

const { items } = Astro.props;
---

<div class="outcomes">
  {
    items.map((o, i) => (
      <div class="outcome" data-reveal style={`--i: ${i}`}>
        <p>
          <strong>{o.label}.</strong> {o.text}
        </p>
      </div>
    ))
  }
</div>

<style>
  .outcomes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .outcome {
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  strong {
    font-weight: 650;
  }

  p {
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  @media (max-width: 47.99rem) {
    .outcomes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
