---
/*
 * One "What I implemented" step: evidence on a tinted panel, the words beside it.
 * Text comes first in the DOM so phones read title → text → evidence.
 * Pass `built` for a one-line answer, or put a list in the default slot.
 */
interface Props {
  title: string;
  task: string;
  built?: string;
}

const { title, task, built } = Astro.props;
---

<div class="step">
  <div class="text" data-reveal>
    <h3>{title}</h3>
    <p><strong>User’s task: </strong>{task}</p>
    {
      built ? (
        <p>
          <strong>What I built: </strong>
          {built}
        </p>
      ) : (
        <>
          <p class="built-label">
            <strong>What I built:</strong>
          </p>
          <slot />
        </>
      )
    }
  </div>
  <figure data-reveal style="--i: 1">
    <slot name="figure" />
  </figure>
</div>

<style>
  .step {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    grid-template-areas: 'figure text';
    align-items: center;
    gap: 24px clamp(2rem, 0.5rem + 3vw, 4rem);
    margin-top: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
  }

  .text {
    grid-area: text;
    color: var(--muted);
  }

  h3 {
    font-size: var(--text-lead);
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .text p {
    margin-top: 10px;
  }

  .built-label {
    margin-bottom: 4px;
  }

  .text :global(ul) {
    margin: 0;
    padding-left: 20px;
  }

  .text :global(li) {
    padding-block: 3px;
  }

  strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* the evidence sits on one tinted panel; its caption stays inside it */
  figure {
    grid-area: figure;
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  figure > :global(*) {
    width: 100%;
  }

  figure :global(figcaption) {
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 63.99rem) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'text'
        'figure';
    }
  }

  @media (max-width: 47.99rem) {
    .text {
      font-size: 16px;
    }

    .text p {
      margin-top: 8px;
    }
  }
</style>
