---
/*
 * One "What I implemented" step: evidence on the left, text on the right.
 * Text comes first in the DOM so phones read title → text → evidence.
 * Pass `built` for a one-line answer, or put a list in the default slot.
 */
interface Props {
  title: string;
  task: string;
  built?: string;
}

const { title, task, built } = Astro.props;
---

<div class="step">
  <div class="text">
    <h3>{title}</h3>
    <p><strong>User’s task: </strong>{task}</p>
    {
      built ? (
        <p class="built">
          <strong>What I built: </strong>
          {built}
        </p>
      ) : (
        <>
          <p class="built-label">
            <strong>What I built:</strong>
          </p>
          <slot />
        </>
      )
    }
  </div>
  <figure>
    <slot name="figure" />
  </figure>
</div>

<style>
  .step {
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 28px 32px;
    margin-top: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }

  .text {
    flex: 1 1 240px;
    min-width: 0;
    font-size: 16px;
  }

  h3 {
    font-size: clamp(1.125rem, 1.079rem + 0.19vw, 1.25rem);
    font-weight: 500;
  }

  .text p {
    margin-top: 10px;
  }

  .text .built {
    margin-top: 8px;
  }

  .built-label {
    margin-bottom: 6px;
  }

  .text :global(ul) {
    margin: 0;
    padding-left: 20px;
  }

  .text :global(li) {
    padding-block: 3px;
  }

  strong {
    font-weight: 600;
  }

  figure {
    flex: 1.3 1 340px;
    min-width: 0;
  }

  figure :global(figcaption) {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 47.99rem) {
    .step {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 12px;
      margin-top: 24px;
      padding-bottom: 24px;
    }

    .text,
    figure {
      flex: none;
    }

    .text {
      font-size: 15px;
    }

    .text p {
      margin-top: 6px;
    }
  }
</style>
