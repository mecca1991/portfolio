---
/*
 * Section index. Wide screens: a sticky column beside the article, with the section
 * in view marked as you scroll. Narrow screens: a row of links above the article,
 * never sticky, so it can't sit on top of the text.
 */
interface Props {
  sections: readonly { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="toc" aria-labelledby="toc-title" data-toc>
  <p id="toc-title" class="title">On this page</p>
  <ol>
    {
      sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-for={s.id}>
            {s.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .toc {
    position: sticky;
    top: 100px;
    font-size: 15px;
  }

  .title {
    margin-bottom: 10px;
    font-weight: 600;
  }

  ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 7px 12px;
    margin-left: -12px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    background: var(--surface);
    color: var(--ink);
  }

  a[aria-current] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 63.99rem) {
    .toc {
      position: static;
    }

    .title {
      margin-bottom: 8px;
    }

    ol {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    a {
      margin-left: 0;
      padding: 8px 14px;
      border-radius: var(--radius-pill);
      background: var(--surface);
      color: var(--ink);
    }
  }
</style>

<script>
  // mark the section currently being read; the links work without this
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  if (toc && sections.length && 'IntersectionObserver' in window) {
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('a[data-for]')].map((a) => [a.dataset.for, a]));
    const visible = new Set<string>();
    const mark = () => {
      const current = sections.find((s) => visible.has(s.id))?.id;
      links.forEach((a, id) => (id === current ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
        mark();
      },
      { rootMargin: '-110px 0px -55% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
