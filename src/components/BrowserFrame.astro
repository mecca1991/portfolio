---
/* A real web capture in a light browser frame. The address bar names where it lives. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  url: string;
  sizes: string;
  eager?: boolean;
}

const { src, alt, url, sizes, eager = false } = Astro.props;
const widths = [480, 720, 960, 1280, 1600, 2000].filter((w) => w <= src.width);
---

<div class="browser" data-ui>
  <div class="chrome" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="url">{url}</span>
  </div>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</div>

<style>
  .browser {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--white);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 36px;
    padding: 0 14px;
    background: #f7f8fa;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d9dde3;
  }

  .url {
    flex: 0 1 320px;
    min-width: 0;
    margin-inline: auto;
    padding: 3px 12px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 47.99rem) {
    .chrome {
      height: 28px;
      gap: 10px;
      padding: 0 10px;
    }

    .dots i {
      width: 7px;
      height: 7px;
    }

    .url {
      padding: 1px 10px;
      font-size: 13px;
    }
  }
</style>
