---
/*
 * A project row: the words on one side, the evidence on a tinted panel on the other.
 * The kind of engagement follows the title as a plain meta line, never a label above it.
 * Phones read: title, one-liner, meta, description, role, evidence, actions.
 */
interface Props {
  id: string;
  title: string;
  oneLiner: string;
  kind: string;
  detail?: string;
  live?: boolean;
  description: string;
  roleLabel?: string;
  role?: string;
  /** evidence on the left on wide screens */
  reverse?: boolean;
}

const { id, title, oneLiner, kind, detail, live = false, description, roleLabel, role, reverse = false } =
  Astro.props;
---

<article class:list={['feature', { reverse }]} aria-labelledby={id}>
  <div class="text" data-reveal>
    <h3 id={id} class="display">{title}</h3>
    <p class="one-liner">{oneLiner}</p>
    <p class="meta">
      {live && <span class="live-dot" aria-hidden="true" />}
      {live && <span class="live">Live</span>}
      {live && ' · '}
      {kind}
      {detail && ` · ${detail}`}
    </p>
    <p class="description">{description}</p>
    {
      role && (
        <p class="role">
          <span>{roleLabel}: </span>
          {role}
        </p>
      )
    }
    <div class="actions"><slot name="actions" /></div>
  </div>
  <figure class="visual" data-reveal style="--i: 1">
    <div class="panel"><slot name="figure" /></div>
    <slot name="caption" />
  </figure>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: 'text visual';
    align-items: center;
    gap: 40px clamp(2.5rem, 0.5rem + 4vw, 5rem);
  }

  .reverse {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas: 'visual text';
  }

  .text {
    grid-area: text;
  }

  .visual {
    grid-area: visual;
  }

  h3 {
    font-size: var(--text-h2);
  }

  .one-liner {
    margin-top: 14px;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .meta {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .live {
    color: var(--ink);
    font-weight: 600;
  }

  .description {
    margin-top: 20px;
    color: var(--muted);
  }

  .role {
    margin-top: 14px;
    font-size: 16px;
  }

  .role span {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin-top: 28px;
  }

  .actions:empty {
    display: none;
  }

  .panel {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(16rem, 10rem + 18vw, 28rem);
    padding: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .visual :global(figcaption) {
    max-width: 40em;
    margin-top: 14px;
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 63.99rem) {
    .feature,
    .reverse {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'text'
        'visual';
      gap: 32px;
    }
  }

  @media (max-width: 47.99rem) {
    .text {
      display: contents;
    }

    .feature,
    .reverse {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .one-liner {
      margin-top: 10px;
    }

    .description {
      margin-top: 14px;
      font-size: 16px;
    }

    .visual {
      order: 1;
      margin-top: 24px;
    }

    .actions {
      order: 2;
      margin-top: 18px;
    }
  }
</style>
