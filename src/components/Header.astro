---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  current?: 'work' | 'experiments';
  showCv?: boolean;
}

const { current, showCv = true } = Astro.props;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/#top">
      <span class="dot" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>
    <nav class="nav-wide" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={item.id === current ? 'true' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    {showCv && <a class="cv" href={site.links.cv}>CV (PDF)</a>}
    <button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
      Menu
    </button>
  </div>
  <nav id="site-menu" class="sheet" aria-label="Primary">
    {
      site.nav.map((item) => (
        <a href={item.href} aria-current={item.id === current ? 'true' : undefined}>
          {item.label}
        </a>
      ))
    }
    {
      showCv && (
        <a class="sheet-cv" href={site.links.cv}>
          CV (PDF) <Icon name="arrow-up-right" />
        </a>
      )
    }
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 14px var(--gutter);
    background: rgb(7 5 13 / 0.6);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  /* an open menu needs a firmer ground than the blur gives it */
  .site-header:has(.sheet[data-open]) {
    background: rgb(7 5 13 / 0.94);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: var(--content-max);
    min-height: 34px;
    margin-inline: auto;
  }

  a {
    text-decoration: none;
  }

  /* links stay small on screen; ::after gives each one a 44px target */
  .brand,
  .nav-wide a,
  .cv {
    position: relative;
  }

  .brand::after,
  .nav-wide a::after,
  .cv::after {
    content: '';
    position: absolute;
    inset: 50% -8px auto;
    height: var(--tap);
    transform: translateY(-50%);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--white);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: oklch(0.7 0.22 var(--h));
    box-shadow: 0 0 14px var(--accent-glow);
  }

  .nav-wide {
    display: flex;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .nav-wide a {
    color: var(--muted-2);
  }

  .nav-wide a:hover,
  .nav-wide a[aria-current] {
    color: var(--white);
  }

  .cv {
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.05);
    font-size: 13px;
    line-height: 1.25;
    color: var(--white);
  }

  .cv:hover {
    background: oklch(0.5 0.22 var(--h));
    border-color: transparent;
    color: var(--white);
  }

  .menu-button,
  .sheet {
    display: none;
  }

  @media (max-width: 760px) {
    .nav-wide,
    .cv {
      display: none;
    }

    .bar {
      min-height: var(--tap);
    }

    /* the button only works with the script, so it only shows with it */
    :global(.js) .menu-button {
      display: block;
      min-height: var(--tap);
      padding: 0 18px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-pill);
      background: rgb(255 255 255 / 0.05);
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--white);
      cursor: pointer;
    }

    .sheet {
      display: flex;
      flex-direction: column;
      max-width: var(--content-max);
      margin: 12px auto 0;
      border-top: 1px solid var(--line);
      font-family: var(--font-mono);
      font-size: 15px;
    }

    /* without the script the list simply stays open under the bar */
    :global(.js) .sheet:not([data-open]) {
      display: none;
    }

    .sheet a {
      padding: 15px 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.06);
      color: var(--ink-soft);
    }

    .sheet a:hover,
    .sheet a[aria-current],
    .sheet .sheet-cv {
      color: var(--white);
    }

    .sheet .sheet-cv {
      border-bottom: 0;
    }
  }
</style>
