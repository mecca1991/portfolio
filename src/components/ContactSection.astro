---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title: string;
  /** closing words of the title, set in italic on the home page */
  emphasis?: string;
  intro: string;
  footer?: boolean;
  /** smaller type and padding, used at the end of detail pages */
  compact?: boolean;
}

const { title, emphasis, intro, footer = false, compact = false } = Astro.props;
const year = new Date().getFullYear();
---

{
  compact ? (
    <section id="contact" class="dark contact compact" aria-labelledby="contact-title">
      <div class="container body">
        <h2 id="contact-title" class="display" data-reveal>
          {title}
        </h2>
        <div class="reach" data-reveal style="--i: 1">
          <p class="intro">{intro}</p>
          <div class="email-row">
            <a class="email" href={`mailto:${site.email}`}>
              {site.email}
            </a>
            <button class="copy" type="button" data-copy={site.email} hidden>
              <span class="when-idle">
                <Icon name="copy" /> Copy
              </span>
              <span class="when-copied">
                <Icon name="check" /> Copied
              </span>
              <span class="visually-hidden" aria-live="polite" />
            </button>
          </div>
          <ul class="links">
            <li>
              <a class="btn btn-secondary" href={site.links.linkedin}>
                LinkedIn <Icon name="arrow-up-right" />
              </a>
            </li>
            <li>
              <a class="btn btn-secondary" href={site.links.github}>
                GitHub <Icon name="arrow-up-right" />
              </a>
            </li>
            <li>
              <a class="btn btn-secondary" href={site.links.cv}>
                CV (PDF) <Icon name="arrow-up-right" />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  ) : (
    <section id="contact" class="close" aria-labelledby="contact-title">
      <div class="centre">
        <p class="kicker">POST /contact</p>
        <h2 id="contact-title">
          {title} {emphasis && <em>{emphasis}</em>}
        </h2>
        <p class="lede">{intro}</p>
        <div class="mail">
          <a class="address" href={`mailto:${site.email}`}>
            {site.email}
          </a>
          <button class="copy-fill" type="button" data-copy={site.email} hidden>
            <span class="when-idle">Copy</span>
            <span class="when-copied">Copied</span>
            <span class="visually-hidden" aria-live="polite" />
          </button>
        </div>
        <ul class="pills">
          <li>
            <a href={site.links.linkedin}>
              LinkedIn <Icon name="arrow-up-right" />
            </a>
          </li>
          <li>
            <a href={site.links.github}>
              GitHub <Icon name="arrow-up-right" />
            </a>
          </li>
          <li>
            <a href={site.links.cv}>
              CV (PDF) <Icon name="arrow-up-right" />
            </a>
          </li>
        </ul>
      </div>
      <div class="horizon" aria-hidden="true" />
      {footer && (
        <footer>
          <span>
            © {year} {site.name}
          </span>
        </footer>
      )}
    </section>
  )
}

<style>
  .contact {
    border-top: 1px solid var(--line);
    color: var(--white);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    align-items: end;
    gap: 32px clamp(2.5rem, 0.5rem + 4vw, 5rem);
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  .contact h2 {
    font-size: var(--text-h1);
  }

  .intro {
    max-width: 34em;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--dark-text-soft);
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 28px;
  }

  .email {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    color: var(--white);
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(in srgb, var(--dark-accent) 70%, transparent);
    text-underline-offset: 7px;
    overflow-wrap: anywhere;
  }

  .dark .email:hover {
    color: var(--dark-accent);
  }

  /* copy: the two labels share one spot and cross-fade */
  .copy {
    display: inline-grid;
    min-height: var(--tap);
    padding: 8px 16px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--dark-surface);
    color: var(--white);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--fade);
  }

  .copy:hover {
    background: var(--surface-2);
  }

  .copy:active {
    transform: scale(0.97);
  }

  .copy > span:not(.visually-hidden) {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition:
      opacity var(--dur-ui) ease,
      filter var(--dur-ui) ease,
      transform var(--dur-ui) var(--ease-out);
  }

  .when-copied {
    color: var(--dark-accent);
    opacity: 0;
    filter: blur(2px);
    transform: translateY(4px);
  }

  .copy[data-state='copied'] .when-idle {
    opacity: 0;
    filter: blur(2px);
    transform: translateY(-4px);
  }

  .copy[data-state='copied'] .when-copied {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .dark .links .btn {
    color: var(--white);
  }

  /* the home page's close: centred, with a glowing horizon under it */
  .close {
    position: relative;
    padding: 96px var(--gutter) 260px;
    text-align: center;
    overflow: hidden;
    scroll-margin-top: 60px;
  }

  .centre {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 680px;
    margin-inline: auto;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--accent-label);
  }

  .close h2 {
    font-size: clamp(40px, 6.5vw, 76px);
    line-height: 1.03;
    letter-spacing: 0;
  }

  .close em {
    color: oklch(0.82 0.14 var(--h));
  }

  .lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted-2);
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px;
    border: 1px solid oklch(0.6 0.2 var(--h) / 0.5);
    border-radius: 28px;
    background: rgb(7 5 13 / 0.7);
    box-shadow: 0 10px 50px oklch(0.5 0.25 var(--h) / 0.35);
  }

  .address {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: clamp(13px, 3.6vw, 15px);
    color: var(--white);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* the two labels share one spot, so the button keeps its width */
  .copy-fill {
    display: inline-grid;
    place-items: center;
    min-width: 92px;
    min-height: var(--tap);
    padding: 10px 20px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--accent-fill);
    font-size: 14px;
    font-weight: 500;
    color: var(--white);
    cursor: pointer;
    transition: background-color var(--fade);
  }

  .copy-fill:hover {
    background: var(--accent-fill-hover);
  }

  .copy-fill > span:not(.visually-hidden) {
    grid-area: 1 / 1;
  }

  .copy-fill .when-copied,
  .copy-fill[data-state='copied'] .when-idle {
    visibility: hidden;
  }

  .copy-fill[data-state='copied'] .when-copied {
    visibility: visible;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .pills a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    padding: 9px 18px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color var(--fade),
      border-color var(--fade);
  }

  .pills a:hover {
    border-color: oklch(0.7 0.18 var(--h));
    color: var(--white);
  }

  /* a circle far wider than the page; only its lit top edge shows */
  .horizon {
    position: absolute;
    top: calc(100% - 110px);
    left: 50%;
    width: max(1500px, 170vw);
    height: max(1500px, 170vw);
    border-top: 1px solid oklch(0.85 0.12 var(--h) / 0.8);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 0%,
      oklch(0.42 0.22 var(--h)) 0,
      oklch(0.25 0.14 var(--h)) 12%,
      #0a0714 30%
    );
    box-shadow:
      0 -24px 110px oklch(0.55 0.26 var(--h) / 0.7),
      0 -4px 24px oklch(0.8 0.18 var(--h) / 0.6);
    transform: translateX(-50%);
    pointer-events: none;
  }

  footer {
    position: absolute;
    inset: auto 0 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    padding: 0 20px;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .compact .body {
    padding-block: clamp(3.5rem, 2.4rem + 4.5vw, 6rem);
  }

  .compact h2 {
    font-size: var(--text-h2);
  }

  @media (max-width: 63.99rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 47.99rem) {
    .intro {
      font-size: 18px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .copy > span:not(.visually-hidden) {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
