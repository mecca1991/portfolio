---
import { site } from '../data/site';

interface Props {
  title: string;
  intro: string;
  footer?: boolean;
  /** smaller type and padding, used at the end of detail pages */
  compact?: boolean;
}

const { title, intro, footer = false, compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<section id="contact" class:list={['dark', 'contact', { compact }]} aria-labelledby="contact-title">
  <div class="container body">
    <div class="pitch">
      <h2 id="contact-title" class="display">{title}</h2>
      <p>{intro}</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <ul class="links">
      <li><a href={site.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
      <li><a href={site.links.github}>GitHub <span aria-hidden="true">↗</span></a></li>
      <li><a href={site.links.cv}>CV (PDF) <span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>
  {
    footer && (
      <div class="container footer">
        <span>
          © {year} {site.name}
        </span>
        <span>Dubai, United Arab Emirates</span>
      </div>
    )
  }
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--canvas);
  }

  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 48px;
    padding-block: clamp(3rem, 1.886rem + 4.571vw, 6rem);
  }

  .pitch {
    flex: 999 1 520px;
    min-width: 0;
  }

  h2 {
    max-width: 16ch;
    font-size: clamp(2rem, 1.629rem + 1.524vw, 3rem);
  }

  p {
    max-width: 32em;
    margin-top: clamp(0.875rem, 0.689rem + 0.762vw, 1.5rem);
    color: var(--dark-text-soft);
  }

  .email {
    display: inline-block;
    margin-top: clamp(1.25rem, 0.971rem + 1.143vw, 2rem);
    padding: 4px 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.314rem + 0.762vw, 2rem);
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }

  .links {
    flex: 1 1 260px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--muted);
    font-size: 17px;
  }

  .links li {
    border-bottom: 1px solid var(--muted);
  }

  .links a {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--dark-line);
    font-size: 14px;
    color: var(--dark-muted);
  }

  .compact {
    margin-top: clamp(2rem, 0.886rem + 4.571vw, 5.5rem);
  }

  .compact .body {
    gap: 40px;
    padding-block: clamp(2.5rem, 1.729rem + 3.048vw, 5rem);
  }

  .compact h2 {
    font-size: clamp(1.75rem, 1.304rem + 1.829vw, 2.5rem);
    line-height: 1.15;
  }

  .compact p {
    margin-top: 18px;
  }

  .compact .email {
    margin-top: clamp(0.875rem, 0.596rem + 1.143vw, 1.375rem);
    padding-block: 5px;
    font-size: clamp(1.375rem, 1.236rem + 0.571vw, 1.75rem);
  }

  @media (max-width: 47.99rem) {
    .body {
      gap: 24px;
      padding-bottom: 24px;
    }

    .links {
      font-size: 16px;
    }

    .links a {
      padding-block: 13px;
    }

    .footer {
      padding-block: 12px 24px;
      border-top: 0;
      font-size: 13px;
    }
  }
</style>
