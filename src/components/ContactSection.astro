---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title: string;
  intro: string;
  footer?: boolean;
  /** smaller type and padding, used at the end of detail pages */
  compact?: boolean;
}

const { title, intro, footer = false, compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<section id="contact" class:list={['dark', 'contact', { compact }]} aria-labelledby="contact-title">
  <div class="container body">
    <h2 id="contact-title" class="display" data-reveal>{title}</h2>
    <div class="reach" data-reveal style="--i: 1">
      <p class="intro">{intro}</p>
      <div class="email-row">
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="copy" type="button" data-copy={site.email} hidden>
          <span class="when-idle"><Icon name="copy" /> Copy</span>
          <span class="when-copied"><Icon name="check" /> Copied</span>
          <span class="visually-hidden" aria-live="polite"></span>
        </button>
      </div>
      <ul class="links">
        <li>
          <a class="btn btn-secondary" href={site.links.linkedin}>LinkedIn <Icon name="arrow-up-right" /></a>
        </li>
        <li><a class="btn btn-secondary" href={site.links.github}>GitHub <Icon name="arrow-up-right" /></a></li>
        <li><a class="btn btn-secondary" href={site.links.cv}>CV (PDF) <Icon name="arrow-up-right" /></a></li>
      </ul>
    </div>
  </div>
  {
    footer && (
      <footer class="container footer">
        <div class="fine">
          <span>
            © {year} {site.name}
          </span>
          <a href="#main">Back to top</a>
        </div>
        <p class="name" aria-hidden="true">
          {site.name}
        </p>
      </footer>
    )
  }
</section>

<style>
  .contact {
    background: var(--dark);
    color: var(--white);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    align-items: end;
    gap: 32px clamp(2.5rem, 0.5rem + 4vw, 5rem);
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  h2 {
    font-size: var(--text-h1);
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 34em;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--dark-text-soft);
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 28px;
  }

  .email {
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--white);
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(in srgb, var(--dark-accent) 70%, transparent);
    text-underline-offset: 7px;
    overflow-wrap: anywhere;
  }

  .dark .email:hover {
    color: var(--dark-accent);
  }

  /* copy: the two labels share one spot and cross-fade */
  .copy {
    display: inline-grid;
    min-height: 40px;
    padding: 8px 16px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--dark-surface);
    color: var(--white);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--fade);
  }

  .copy:hover {
    background: #1f262e;
  }

  .copy:active {
    transform: scale(0.97);
  }

  .copy > span:not(.visually-hidden) {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition:
      opacity var(--dur-ui) ease,
      filter var(--dur-ui) ease,
      transform var(--dur-ui) var(--ease-out);
  }

  .when-copied {
    color: var(--dark-accent);
    opacity: 0;
    filter: blur(2px);
    transform: translateY(4px);
  }

  .copy[data-state='copied'] .when-idle {
    opacity: 0;
    filter: blur(2px);
    transform: translateY(-4px);
  }

  .copy[data-state='copied'] .when-copied {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .dark .links .btn {
    color: var(--white);
  }

  .footer {
    overflow: hidden;
  }

  /* the name returns at full width as the page's close */
  .name {
    font-size: clamp(2.5rem, 10.4vw, 9.5rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: #5f6b78; /* 3.6:1 on dark: large decorative type; the name is also in the line above */
    margin-top: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
    margin-bottom: -0.12em; /* the descender-less name sits on the page's bottom edge */
  }

  .fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 28px;
    font-size: var(--text-small);
    color: var(--dark-muted);
  }

  .compact .body {
    padding-block: clamp(3.5rem, 2.4rem + 4.5vw, 6rem);
  }

  .compact h2 {
    font-size: var(--text-h2);
  }

  @media (max-width: 63.99rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 47.99rem) {
    .intro {
      font-size: 18px;
    }

    .fine {
      padding-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy > span:not(.visually-hidden) {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
