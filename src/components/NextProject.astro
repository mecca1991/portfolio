---
import Icon from './Icon.astro';

interface Props {
  label: string;
  title: string;
  href: string;
  backLabel?: string;
  backHref?: string;
}

const { label, title, href, backLabel = 'Back to projects', backHref = '/#work' } = Astro.props;
---

<nav class="container next" aria-label="Next project">
  <a class="card" href={href} data-reveal>
    <span class="body">
      <span class="title">{title}</span>
      <span class="label">{label}</span>
    </span>
    <span class="go" aria-hidden="true"><Icon name="arrow-right" /></span>
  </a>
  <a class="link-ink back" href={backHref}><Icon name="arrow-left" /> {backLabel}</a>
</nav>

<style>
  .next {
    margin-top: var(--section);
    margin-bottom: var(--section);
  }

  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(1.5rem, 0.8rem + 2.8vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--fade),
      transform var(--dur-press) var(--ease-out);
  }

  .card:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .card:active {
    transform: scale(0.99);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .title {
    font-size: var(--text-h2);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .label {
    font-size: 15px;
    color: var(--muted);
  }

  .go {
    display: grid;
    flex: none;
    place-items: center;
    width: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
    height: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .go :global(.icon) {
    transition: transform var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .go :global(.icon) {
      transform: translateX(3px);
    }
  }

  .back {
    margin-top: 12px;
    font-size: 15px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:active {
      transform: none;
    }
  }
</style>
