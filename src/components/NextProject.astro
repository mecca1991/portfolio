---
interface Props {
  label: string;
  title: string;
  href: string;
  backLabel?: string;
  backHref?: string;
}

const { label, title, href, backLabel = 'Back to selected work', backHref = '/#work' } = Astro.props;
---

<nav class="container next" aria-label="Next project">
  <a class="card" href={href}>
    <span class="body">
      <span class="label">{label}</span>
      <span class="title">{title} <span class="arrow-phone" aria-hidden="true">→</span></span>
    </span>
    <span class="cta">Read next <span aria-hidden="true">→</span></span>
  </a>
  <a class="back" href={backHref}><span aria-hidden="true">← </span>{backLabel}</a>
</nav>

<style>
  .next {
    margin-top: clamp(3rem, 1.4rem + 5.333vw, 6.5rem);
  }

  .card {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-block: 36px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .card:hover .title {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .label {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.304rem + 1.829vw, 2.5rem);
    line-height: 1.1;
  }

  .arrow-phone {
    display: none;
    color: var(--accent);
  }

  .cta {
    padding: 8px 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--accent);
  }

  .back {
    display: inline-block;
    margin-top: 14px;
    padding: 10px 0;
    font-size: 16px;
    color: var(--ink);
  }

  @media (max-width: 47.99rem) {
    .card {
      padding-block: 20px;
    }

    .body {
      gap: 4px;
    }

    .label {
      font-size: 12px;
    }

    .arrow-phone {
      display: inline;
    }

    .cta {
      display: none;
    }

    .back {
      margin-top: 8px;
      font-size: 15px;
    }
  }
</style>
