---
/*
 * The only client JS on the site. Without JS it shows the starting example as a static,
 * read-only preview: controls stay disabled until the script enables them.
 */
import Label from './Label.astro';
import { SAMPLES, LABELS, parseToRows, type SampleId } from '../scripts/json-tree';

const initial: SampleId = 'nested';
const ids = Object.keys(SAMPLES) as SampleId[];
const { rows } = parseToRows(SAMPLES[initial], true);
---

<section class="container playground" aria-labelledby="rp-play" data-playground>
  <div class="box" data-ui>
    <div class="head">
      <h2 id="rp-play" class="display">Playground</h2>
      <Label dashed>Proposed feature</Label>
    </div>
    <p class="note">
      Not built yet. The plan is to compile the Rust parser to WebAssembly and run it here. Until then, this preview
      uses the browser’s own JSON parser.
    </p>
    <p class="note no-js">Turn on JavaScript to edit the example. This is its starting state.</p>

    <div class="tabs" role="group" aria-label="Examples">
      {
        ids.map((id) => (
          <button type="button" class="tab" data-sample={id} aria-pressed={id === initial ? 'true' : 'false'} disabled>
            {LABELS[id]}
          </button>
        ))
      }
    </div>

    <div class="io">
      <div class="col">
        <label for="rp-input">JSON input</label>
        <textarea id="rp-input" spellcheck="false" readonly>{SAMPLES[initial]}</textarea>
      </div>
      <div class="col">
        <div class="out-head">
          <span>Parsed output</span>
          <button type="button" class="expand" aria-expanded="true" aria-controls="rp-output" disabled>
            Collapse to top level
          </button>
        </div>
        <div id="rp-output" class="output" aria-live="polite">
          <div class="error" hidden>
            <div class="error-title">Couldn’t parse this input</div>
            <div class="error-text"></div>
          </div>
          <code class="rows">
            {
              rows.map((r) => (
                <span class="row" style={`padding-left: ${r.depth * 22}px`}>
                  <span class="key">{r.key}</span>
                  <span class="type">{r.type}</span> <span>{r.value}</span>
                </span>
              ))
            }
          </code>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { SAMPLES, parseToRows, type SampleId } from '../scripts/json-tree';

  const root = document.querySelector<HTMLElement>('[data-playground]');

  if (root) {
    const input = root.querySelector('textarea')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
    const expand = root.querySelector<HTMLButtonElement>('.expand')!;
    const errorBox = root.querySelector<HTMLElement>('.error')!;
    const errorText = root.querySelector<HTMLElement>('.error-text')!;
    const rowsEl = root.querySelector<HTMLElement>('.rows')!;
    let expanded = true;

    const span = (className: string, text: string) => {
      const el = document.createElement('span');
      el.className = className;
      el.textContent = text;
      return el;
    };

    const render = () => {
      const { rows, error } = parseToRows(input.value, expanded);
      errorBox.hidden = !error;
      errorText.textContent = error;
      expand.hidden = rows.length === 0;
      expand.setAttribute('aria-expanded', String(expanded));
      expand.textContent = expanded ? 'Collapse to top level' : 'Expand all';
      rowsEl.replaceChildren(
        ...rows.map((r) => {
          const line = document.createElement('span');
          line.className = 'row';
          line.style.paddingLeft = `${r.depth * 22}px`;
          line.append(span('key', r.key), span('type', r.type), ' ', span('', r.value));
          return line;
        }),
      );
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        input.value = SAMPLES[tab.dataset.sample as SampleId];
        for (const t of tabs) t.setAttribute('aria-pressed', String(t === tab));
        render();
      });
    }

    expand.addEventListener('click', () => {
      expanded = !expanded;
      render();
    });

    input.addEventListener('input', render);

    for (const control of [...tabs, expand]) control.disabled = false;
    input.readOnly = false;
    root.querySelector<HTMLElement>('.no-js')!.hidden = true;
  }
</script>

<style>
  .playground {
    margin-top: var(--section);
  }

  /* a proposed feature: a tinted panel with a warm chip, never mistaken for the built parser */
  .box {
    padding: clamp(1.25rem, 0.6rem + 2.6vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  h2 {
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .note {
    max-width: 46em;
    margin-top: 12px;
    font-size: 16px;
    color: var(--muted);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  button {
    min-height: 44px;
    padding: 8px 18px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--fade),
      color var(--fade),
      transform var(--dur-press) var(--ease-out);
  }

  button:hover:not(:disabled) {
    background: #dfe3e8;
  }

  button:active:not(:disabled) {
    transform: scale(0.97);
  }

  button:disabled {
    cursor: default;
  }

  .tab[aria-pressed='true'],
  .tab[aria-pressed='true']:hover {
    background: var(--ink);
    color: var(--white);
  }

  .io {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  label,
  .out-head span {
    font-size: 15px;
    font-weight: 600;
  }

  label {
    margin-bottom: 8px;
  }

  .out-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .expand {
    min-height: 36px;
    padding: 6px 14px;
    background: var(--white);
    font-size: 14px;
  }

  textarea,
  .output {
    flex: 1;
    min-height: 260px;
    border-radius: var(--radius);
    font-family: var(--font-mono); /* taste-skill-ignore: literal JSON in and out */
    font-size: 14px;
  }

  textarea {
    width: 100%;
    padding: 16px 18px;
    border: 0;
    background: var(--dark);
    color: var(--dark-text-soft);
    line-height: 1.6;
    resize: vertical;
    caret-color: var(--dark-accent);
  }

  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .output {
    padding: 16px 18px;
    overflow: auto;
    background: var(--white);
    line-height: 1.75;
  }

  .error {
    margin-bottom: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--error-bg);
    font-family: var(--font-body);
    color: var(--error-text);
  }

  .error-title {
    font-weight: 600;
  }

  .error-text {
    margin-top: 4px;
    font-size: 15px;
  }

  .rows {
    display: block;
    font-family: var(--font-mono); /* taste-skill-ignore: literal JSON in and out */
  }

  /* rows are rebuilt by the script, so their styles can't be scoped */
  .rows :global(.row) {
    display: block;
    white-space: nowrap;
  }

  .rows :global(.key) {
    color: var(--muted);
  }

  .rows :global(.type) {
    font-weight: 600;
  }

  @media (max-width: 47.99rem) {
    .io {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    textarea,
    .output {
      min-height: 200px;
      font-size: 13px;
    }
  }
</style>
