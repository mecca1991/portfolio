---
interface Props {
  id: string;
  /** kept for older call sites; the order shows by position */
  number?: string;
  title: string;
  /** full article width instead of the reading column */
  wide?: boolean;
}

const { id, title, wide = false } = Astro.props;
---

<section id={id} class:list={['case-section', { wide }]} aria-labelledby={`h-${id}`} data-section>
  <h2 id={`h-${id}`} class="display" data-reveal>{title}</h2>
  <slot />
</section>

<style>
  .case-section {
    max-width: 720px;
    scroll-margin-top: 96px;
  }

  .case-section + .case-section {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .wide {
    max-width: none;
  }

  h2 {
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .case-section > :global(p) {
    max-width: 720px;
    margin-top: 18px;
  }

  .case-section > :global(ul) {
    max-width: 720px;
    margin: 18px 0 0;
    padding-left: 22px;
  }

  .case-section > :global(ul li) {
    padding-block: 5px;
  }

  .case-section > :global(ul li::marker) {
    color: var(--muted);
  }

  @media (max-width: 47.99rem) {
    .case-section > :global(p),
    .case-section > :global(ul) {
      margin-top: 14px;
    }
  }
</style>
