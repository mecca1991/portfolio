---
/* Missing asset: surface fill and a bracketed request. Never a stock or generated substitute. */
interface Props {
  text: string;
  ratio?: string;
  phoneRatio?: string;
  icon?: boolean;
}

const { text, ratio = '16 / 10', phoneRatio = ratio, icon = true } = Astro.props;
---

<div class="capture" style={{ '--ratio': ratio, '--ratio-phone': phoneRatio }}>
  {
    icon && (
      <svg
        aria-hidden="true"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M3 15l5-5 4 4 3-3 6 6" />
      </svg>
    )
  }
  <p>{text}</p>
</div>

<style>
  .capture {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: var(--ratio);
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    text-align: center;
  }

  p {
    max-width: 30em;
    font-size: 15px;
  }

  @media (max-width: 47.99rem) {
    .capture {
      aspect-ratio: var(--ratio-phone);
      padding: 24px;
    }

    p {
      font-size: 14px;
    }
  }
</style>
