---
import { site } from '../data/site';
---

<section class="writing" aria-labelledby="writing-title">
  <div class="container layout">
    <div class="intro">
      <h2 id="writing-title" class="display">Writing</h2>
      <p>Plain explanations of tools I use.</p>
    </div>
    <ul>
      {
        site.writing.map((item) => (
          <li>
            <p class="meta">{item.meta}</p>
            <h3>{item.title}</h3>
            {'description' in item && <p class="description">{item.description}</p>}
            <div class="links">
              {item.links.map((link) => (
                <a href={link.href}>
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    padding-block: clamp(2.5rem, 1.386rem + 4.571vw, 5.5rem) 0;
  }

  .intro {
    flex: 1 1 260px;
    min-width: 0;
  }

  h2 {
    font-size: clamp(1.75rem, 1.564rem + 0.762vw, 2.25rem);
    line-height: 1.15;
  }

  .intro p {
    margin-top: 14px;
    font-size: 16px;
    color: var(--muted);
  }

  ul {
    flex: 2.4 1 560px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  li {
    padding-block: 22px 12px;
    border-bottom: 1px solid var(--line);
  }

  .meta {
    font-size: 14px;
    color: var(--muted);
  }

  h3 {
    margin-top: 6px;
    font-size: clamp(1.0625rem, 0.971rem + 0.381vw, 1.3125rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .description {
    margin-top: 6px;
    font-size: 16px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-top: 2px;
    font-size: 16px;
  }

  .links a {
    padding: 10px 0;
  }

  @media (max-width: 47.99rem) {
    .layout {
      padding-bottom: 8px;
    }

    .intro p {
      margin-top: 6px;
      font-size: 15px;
    }

    ul {
      flex-basis: 100%;
    }

    li {
      padding-block: 16px 6px;
    }

    .meta {
      font-size: 13px;
    }

    .description,
    .links {
      font-size: 15px;
    }
  }
</style>
