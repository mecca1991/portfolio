---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="writing" aria-labelledby="writing-title">
  <div class="container layout">
    <div class="intro" data-reveal>
      <h2 id="writing-title" class="display">Writing</h2>
      <p>Plain explanations of tools I use.</p>
    </div>
    <ul>
      {
        site.writing.map((item, i) => {
          const [primary, ...rest] = item.links;
          return (
            <li data-reveal style={`--i: ${i + 1}`}>
              <h3>
                <a href={primary.href}>
                  {item.title} <Icon name="arrow-up-right" />
                </a>
              </h3>
              <p class="meta">
                <span>{item.meta}</span>
                {rest.map((link) => (
                  <a class="link-ink" href={link.href}>
                    {link.label} <Icon name="arrow-up-right" />
                  </a>
                ))}
              </p>
              {'description' in item && <p class="description">{item.description}</p>}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 32px clamp(2.5rem, 0.5rem + 4vw, 5rem);
    padding-block: var(--section) 0;
  }

  h2 {
    font-size: var(--text-h2);
  }

  .intro p {
    margin-top: 14px;
    font-size: var(--text-lead);
    color: var(--muted);
  }

  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 24px 28px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: background-color var(--fade);
  }

  li:hover {
    background: var(--surface-2);
  }

  .meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 18px;
    margin-top: 4px;
    font-size: var(--text-small);
    color: var(--muted);
  }

  .meta .link-ink {
    min-height: 32px;
    font-size: 15px;
  }

  h3 {
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  /* the whole row opens the piece; other links stay clickable above it */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  h3 :global(.icon) {
    display: inline;
    margin-left: 2px;
    color: var(--muted);
  }

  .description {
    max-width: 44em;
    margin-top: 8px;
    color: var(--muted);
  }

  li:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  h3 a:focus-visible {
    outline: none;
  }

  @media (max-width: 63.99rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 47.99rem) {
    li {
      padding: 20px;
    }

    .description {
      font-size: 16px;
    }
  }
</style>
