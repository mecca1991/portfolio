---
/*
 * Shared frame for case studies: intro and facts, an "On this page" index beside the
 * numbered sections (default slot), the next-project link and a compact contact block.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Label from '../components/Label.astro';
import OnThisPage from '../components/OnThisPage.astro';
import NextProject from '../components/NextProject.astro';
import ContactSection from '../components/ContactSection.astro';

type Fact = { term: string; detail?: string; links?: readonly { label: string; href: string }[] };

interface Props {
  title: string;
  description: string;
  label: string;
  detail?: string;
  heading: string;
  subtitle: string;
  intro: string;
  /** muted line under the intro, e.g. scope of my involvement */
  note?: string;
  facts: readonly Fact[];
  sections: readonly { id: string; label: string }[];
  next: { label: string; title: string; href: string };
  contact: { title: string; intro: string };
}

const { title, description, label, detail, heading, subtitle, intro, note, facts, sections, next, contact } =
  Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header current="work" />
  <main id="main">
    <div class="container back">
      <a href="/#work"><span aria-hidden="true">← </span>Projects</a>
    </div>

    <section class="container intro" aria-labelledby="case-title">
      <div class="lede">
        <div class="meta">
          <Label>{label}</Label>
          {detail && <span class="detail">{detail}</span>}
        </div>
        <h1 id="case-title" class="display">{heading}</h1>
        <p class="subtitle">{subtitle}</p>
        <p class="summary">{intro}</p>
        {note && <p class="note">{note}</p>}
      </div>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.term}</dt>
              <dd>
                {f.detail}
                {f.links?.map((l) => (
                  <a href={l.href}>
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="container body">
      <OnThisPage sections={sections} />
      <article>
        <slot />
      </article>
    </div>

    <NextProject label={next.label} title={next.title} href={next.href} />
  </main>
  <ContactSection title={contact.title} intro={contact.intro} compact />
</BaseLayout>

<style>
  .back {
    padding-top: clamp(0.75rem, 0.379rem + 1.524vw, 2rem);
  }

  .back a {
    display: inline-block;
    padding: 10px 0;
    font-size: clamp(0.9375rem, 0.914rem + 0.095vw, 1rem);
    color: var(--ink);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 20px 56px;
    padding-block: clamp(0.75rem, 0.157rem + 2.438vw, 2rem) clamp(2rem, 1.257rem + 3.048vw, 4rem);
  }

  .lede {
    flex: 999 1 600px;
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .detail {
    font-size: clamp(0.8125rem, 0.789rem + 0.095vw, 0.875rem);
    color: var(--muted);
  }

  h1 {
    margin-top: clamp(1rem, 0.907rem + 0.381vw, 1.25rem);
    font-size: clamp(2.5rem, 2.036rem + 1.905vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .subtitle {
    max-width: 26ch;
    margin-top: clamp(0.5rem, 0.407rem + 0.381vw, 0.75rem);
    font-family: var(--font-display);
    font-size: clamp(1.3125rem, 1.15rem + 0.667vw, 1.75rem);
    line-height: 1.3;
  }

  .summary {
    max-width: 36em;
    margin-top: clamp(0.875rem, 0.643rem + 0.952vw, 1.5rem);
  }

  .note {
    max-width: 36em;
    margin-top: 16px;
    font-size: clamp(0.9375rem, 0.914rem + 0.095vw, 1rem);
    color: var(--muted);
  }

  .facts {
    flex: 1 1 340px;
    border-top: 1px solid var(--ink);
    font-size: clamp(0.9375rem, 0.914rem + 0.095vw, 1rem);
    line-height: 1.5;
  }

  .facts div {
    display: flex;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    flex: 0 0 104px;
    color: var(--muted);
  }

  .facts dd {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .facts dd a {
    padding: 3px 0;
  }

  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 64px;
    border-top: 1px solid var(--line);
  }

  article {
    flex: 999 1 640px;
    min-width: 0;
    padding-top: 32px;
  }

  @media (max-width: 47.99rem) {
    .facts {
      margin-top: 0;
      line-height: 1.45;
    }

    .facts div {
      gap: 12px;
      padding-block: 10px;
    }

    .facts dt {
      flex-basis: 92px;
    }

    .facts dd a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0;
    }

    .body {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      border-top: 0;
    }

    .body > :global(*) {
      flex: none;
      width: 100%;
    }

    article {
      padding-top: 40px;
    }
  }
</style>
