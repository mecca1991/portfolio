---
/*
 * Shared frame for case studies: title and facts, an optional cover, a section index
 * beside the article on wide screens (above it on narrow ones), the next project and contact.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import OnThisPage from '../components/OnThisPage.astro';
import NextProject from '../components/NextProject.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';

type Fact = { term: string; detail?: string; links?: readonly { label: string; href: string }[] };

interface Props {
  title: string;
  description: string;
  label: string;
  detail?: string;
  heading: string;
  subtitle: string;
  intro: string;
  /** muted line under the intro, e.g. scope of my involvement */
  note?: string;
  facts: readonly Fact[];
  sections: readonly { id: string; label: string }[];
  next: { label: string; title: string; href: string };
  contact: { title: string; intro: string };
}

const { title, description, label, detail, heading, subtitle, intro, note, facts, sections, next, contact } =
  Astro.props;
const live = detail === 'Live';
---

<BaseLayout title={title} description={description}>
  <Header current="work" />
  <main id="main">
    <div class="container top">
      <section class="intro" aria-labelledby="case-title">
        <div class="lede">
          <h1 id="case-title" class="display" data-reveal>{heading}</h1>
          <p class="subtitle" data-reveal style="--i: 1">{subtitle}</p>
          <p class="meta" data-reveal style="--i: 1">
            {live && <span class="live-dot" aria-hidden="true" />}
            {live ? <><span class="live">Live</span>{` · ${label}`}</> : <>{label}{detail && ` · ${detail}`}</>}
          </p>
          <p class="summary" data-reveal style="--i: 2">{intro}</p>
          {note && <p class="note" data-reveal style="--i: 2">{note}</p>}
        </div>
        <dl class="facts" data-reveal style="--i: 2">
          {
            facts.map((f) => (
              <div>
                <dt>{f.term}</dt>
                <dd>
                  {f.detail}
                  {f.links?.map((l) => (
                    <a href={l.href}>
                      {l.label} <Icon name="arrow-up-right" />
                    </a>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      {Astro.slots.has('cover') && <figure class="cover" data-reveal style="--i: 3"><slot name="cover" /></figure>}
    </div>

    <div class="container body">
      <OnThisPage sections={sections} />
      <article>
        <slot />
      </article>
    </div>

    <NextProject label={next.label} title={next.title} href={next.href} />
  </main>
  <ContactSection title={contact.title} intro={contact.intro} compact />
</BaseLayout>

<style>
  .top {
    padding-top: clamp(1rem, 0.6rem + 1.6vw, 2rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: 32px clamp(2.5rem, 0.5rem + 4vw, 5rem);
    padding-block: clamp(1.5rem, 0.9rem + 2.4vw, 3.5rem) 0;
  }

  h1 {
    font-size: var(--text-h1);
    letter-spacing: -0.04em;
  }

  .subtitle {
    max-width: 30ch;
    margin-top: 16px;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .meta {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .live {
    color: var(--ink);
    font-weight: 600;
  }

  .summary {
    max-width: 36em;
    margin-top: 24px;
  }

  .note {
    max-width: 36em;
    margin-top: 14px;
    font-size: 16px;
    color: var(--muted);
  }

  /* facts sit on one tinted panel, rows separated by space */
  .facts {
    display: grid;
    gap: 16px;
    padding: clamp(1.25rem, 0.9rem + 1.4vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: 16px;
    line-height: 1.5;
  }

  .facts div {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 16px;
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .facts dd a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
  }

  .cover {
    margin-top: clamp(2.5rem, 1.9rem + 2.5vw, 4rem);
  }

  .body {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: start;
    gap: clamp(3rem, 1rem + 4vw, 6rem);
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  article {
    min-width: 0;
  }

  /* below 64rem the index sits above the article and nothing is sticky */
  @media (max-width: 63.99rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 47.99rem) {
    .summary {
      font-size: 17px;
    }

    .facts div {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
    }

    .facts dd a {
      min-height: 44px;
    }

    .body {
      padding-top: 56px;
    }
  }
</style>
