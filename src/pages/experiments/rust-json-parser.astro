---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import JsonPlayground from '../../components/JsonPlayground.astro';
import NextProject from '../../components/NextProject.astro';
import ContactSection from '../../components/ContactSection.astro';
import Icon from '../../components/Icon.astro';

const source = 'https://github.com/mecca1991/rust-cohort/tree/main/rust-json-parser';

const input = `{
  "name": "Ada",
  "tags": ["rust", "json"],
  "active": true
}`;

const parsed = `Object (3 keys)
├ name: String "Ada"
├ tags: Array (2 items)
│  ├ String "rust"
│  └ String "json"
└ active: Bool true`;

const steps = [
  {
    title: 'Tokenization',
    text: 'The tokenizer reads characters and produces tokens: braces, brackets, strings, numbers, literals and separators.',
  },
  {
    title: 'Recursive parsing',
    text: 'The parser builds typed values from tokens, calling itself for each nested array or object.',
  },
  {
    title: 'Explicit errors',
    text: 'Code review caught places that assumed well-formed input and could panic. They now return a structured error instead.',
  },
];
---

<BaseLayout
  title="Rust JSON Parser · Wilfred Chetat"
  description="A custom JSON tokenizer and parser in Rust with typed values, structured errors and formatting."
>
  <Header current="experiments" showCv={false} />
  <main id="main">
    <section class="container intro" aria-labelledby="rp-title">
      <div class="lede">
        <h1 id="rp-title" class="display" data-reveal>Rust JSON Parser</h1>
        <p class="meta" data-reveal style="--i: 1">Personal project · Rust, parsing, testing</p>
        <p class="summary" data-reveal style="--i: 1">
          A custom tokenizer and parser supporting nested arrays and objects, typed JSON values, structured errors and
          JSON formatting. I revised it after code review.
        </p>
        <div class="actions" data-reveal style="--i: 2">
          <a class="btn btn-primary" href={source}>View source <Icon name="arrow-up-right" /></a>
          <a class="link-ink" href="/#experiments"><Icon name="arrow-left" /> Engineering experiments</a>
        </div>
      </div>
      <dl class="facts" data-reveal style="--i: 2">
        <div><dt>Engagement</dt><dd>Personal project</dd></div>
        <div><dt>Tests</dt><dd>105 test functions in the repository</dd></div>
        <div><dt>Status</dt><dd>Not intended for production use</dd></div>
      </dl>
    </section>

    <section class="dark io-band" aria-labelledby="rp-io">
      <div class="container">
        <h2 id="rp-io" class="display" data-reveal>From text to typed values</h2>
        <figure data-reveal style="--i: 1">
          <div class="panels">
            <div class="panel">
              <p class="panel-name">Input</p>
              <pre tabindex="0" role="region" aria-label="JSON input"><code>{input}</code></pre>
            </div>
            <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
            <div class="panel parsed">
              <p class="panel-name">Parsed structure</p>
              <pre tabindex="0" role="region" aria-label="Parsed structure"><code>{parsed}</code></pre>
            </div>
          </div>
          <figcaption>Illustrative output. Type names are simplified.</figcaption>
        </figure>
      </div>
    </section>

    <section class="container how" aria-labelledby="rp-how">
      <h2 id="rp-how" class="display" data-reveal>How it works</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li data-reveal style={`--i: ${i}`}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <figure class="snippet" data-reveal>
        <pre tabindex="0" role="region" aria-label="Error handling, before and after"><code><span class="comment">// Before: assumes another character exists</span>
let ch = chars.next().unwrap();

<span class="comment">// After: the caller receives a structured error</span>
let ch = chars.next().ok_or(ParseError::UnexpectedEnd)?;</code></pre>
        <figcaption>Illustrative pattern, not copied from the repository.</figcaption>
      </figure>
    </section>

    <JsonPlayground />

    <NextProject
      label="Next project · Personal product"
      title="Intrvuer"
      href="/work/intrvuer/"
      backLabel="Back to experiments"
      backHref="/#experiments"
    />
  </main>

  <ContactSection
    title="Tell me what you’re building."
    intro="I’m Wilfred Chetat, a senior software engineer. Send a short outline of what you’re building."
    compact
  />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: 32px clamp(2.5rem, 0.5rem + 4vw, 5rem);
    padding-block: clamp(2.5rem, 1.6rem + 3.7vw, 5rem) clamp(4rem, 3rem + 4vw, 7rem);
  }

  h1 {
    font-size: var(--text-h1);
    letter-spacing: -0.045em;
  }

  .meta {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .summary {
    max-width: 36em;
    margin-top: 20px;
    font-size: var(--text-lead);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 28px;
  }

  .actions .link-ink {
    font-size: 15px;
  }

  .facts {
    display: grid;
    gap: 16px;
    padding: clamp(1.25rem, 0.9rem + 1.4vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: 16px;
    line-height: 1.5;
  }

  .facts div {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 16px;
  }

  .facts dt {
    color: var(--muted);
  }

  h2 {
    font-size: var(--text-h2);
  }

  /* input to output on a dark band, the way an editor shows it */
  .io-band {
    background: var(--dark);
    color: var(--white);
  }

  .io-band > .container {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .io-band figure {
    margin-top: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .panel {
    height: 100%;
    padding: 20px 22px;
    border-radius: var(--radius);
    background: var(--dark-surface);
  }

  .parsed {
    background: #11171c;
  }

  .panel-name {
    margin-bottom: 10px;
    font-size: 14px;
    color: var(--dark-muted);
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--dark-surface);
    color: var(--dark-accent);
    font-size: 20px;
  }

  pre {
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.7;
  }

  .io-band pre {
    color: var(--dark-text-soft);
  }

  figcaption {
    margin-top: 14px;
    font-size: var(--text-caption);
    color: var(--muted);
  }

  .io-band figcaption {
    color: var(--dark-muted);
  }

  .how {
    padding-top: var(--section);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: clamp(2rem, 1.4rem + 2.5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  h3 {
    font-size: var(--text-lead);
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .steps p {
    margin-top: 10px;
  }

  .snippet {
    margin-top: 12px;
  }

  .snippet pre {
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: var(--dark-text-soft);
  }

  .comment {
    color: var(--dark-muted);
  }

  @media (max-width: 63.99rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 47.99rem) {
    .summary {
      font-size: 18px;
    }

    .panels {
      grid-template-columns: minmax(0, 1fr);
    }

    .arrow {
      justify-self: center;
      transform: rotate(90deg);
    }

    pre {
      font-size: 13px;
    }

    .facts div {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
