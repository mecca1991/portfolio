---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import CaseSection from '../../components/CaseSection.astro';
import ImplementedStep from '../../components/ImplementedStep.astro';
import CapturePlaceholder from '../../components/CapturePlaceholder.astro';
import Decision from '../../components/Decision.astro';
import Outcomes from '../../components/Outcomes.astro';

const sections = [
  { id: 'purpose', label: 'Purpose and users' },
  { id: 'problem', label: 'The problem' },
  { id: 'implemented', label: 'What I implemented' },
  { id: 'decisions', label: 'Decisions and tradeoffs' },
  { id: 'outcomes', label: 'Outcomes' },
];
---

<CaseStudyLayout
  title="Intrvuer case study · Wilfred Chetat"
  description="How I designed, built and deployed Intrvuer, a spoken interview coach with feedback on every answer."
  label="Personal product"
  detail="Live"
  heading="Intrvuer"
  subtitle="Spoken interview practice with feedback on every answer."
  intro="A candidate adds a résumé and a target job, answers interview questions out loud, and reviews feedback on each answer. I designed, built and deployed it."
  facts={[
    { term: 'Engagement', detail: 'Personal product' },
    { term: 'My role', detail: 'Design, frontend, backend, integrations, deployment' },
    { term: 'Users', detail: 'Job candidates preparing for interviews' },
    { term: 'Stack', detail: 'Next.js, FastAPI, background processing, speech and LLM services' },
    { term: 'Dates', detail: '[Start date] – present' },
    {
      term: 'Links',
      links: [
        { label: 'intrvuer.com', href: 'https://intrvuer.com/' },
        { label: 'Sample feedback report', href: 'https://intrvuer.com/sample-report' },
      ],
    },
  ]}
  sections={sections}
  next={{ label: 'Next · Freelance client project', title: 'Sysconnector', href: '/work/sysconnector/' }}
  contact={{
    title: 'Building something similar?',
    intro: 'I’m Wilfred Chetat, a senior backend engineer in Dubai. Send a short outline of what you’re building.',
  }}
>
  <CaseSection id="purpose" number="01" title="Purpose and users">
    <p>
      Intrvuer is for candidates who want to rehearse for a specific role. It uses their résumé and the job they are
      targeting so practice questions and feedback relate to that role. I built it as my own product and handle its
      design, engineering and deployment.
    </p>
  </CaseSection>

  <CaseSection id="problem" number="02" title="The problem">
    <p>
      Reading a list of likely questions is different from answering one out loud. Candidates rarely get feedback on a
      specific answer unless someone sits with them.
    </p>
    <ul>
      <li>Context has to come from documents candidates already have.</li>
      <li>Feedback is only useful when it points at a specific answer.</li>
      <li>Speech and language services take time, so the session must show what is happening.</li>
    </ul>
  </CaseSection>

  <CaseSection id="implemented" number="03" title="What I implemented" wide>
    <ImplementedStep
      title="1 · Context setup"
      task="add a résumé and the job being targeted."
      built="the intake screens and the API that stores this context for the session."
    >
      <CapturePlaceholder
        slot="figure"
        text="[Approved capture needed] Context setup: résumé and target job"
        phoneRatio="4 / 3"
        icon={false}
      />
    </ImplementedStep>

    <ImplementedStep
      title="2 · Spoken practice"
      task="answer questions and follow-ups out loud."
      built="the session interface, speech handling and the backend that sequences questions and follow-ups."
    >
      <CapturePlaceholder
        slot="figure"
        text="[Approved capture needed] Spoken practice, mid-session"
        phoneRatio="4 / 3"
        icon={false}
      />
    </ImplementedStep>

    <ImplementedStep
      title="3 · Feedback report"
      task="review what worked and what to change in each answer."
      built="background processing with LLM integrations that produce per-answer feedback, and the report view."
    >
      <Fragment slot="figure">
        <CapturePlaceholder text="[Approved capture needed] Feedback on one answer" phoneRatio="4 / 3" icon={false} />
        <figcaption>Use the public sample report, which features a fictional candidate.</figcaption>
      </Fragment>
    </ImplementedStep>

    <figure class="flow">
      <ol>
        <li><span class="node"><strong>Context</strong><span>Résumé, target job</span></span></li>
        <li><span class="node"><strong>Interface</strong><span>Next.js session</span></span></li>
        <li><span class="node key"><strong>Backend</strong><span>FastAPI</span></span></li>
        <li class="group">
          <ul>
            <li class="node"><strong>Background jobs</strong></li>
            <li class="node"><strong>Speech services</strong></li>
            <li class="node"><strong>LLM integrations</strong></li>
          </ul>
        </li>
        <li><span class="node"><strong>Report</strong><span>Per-answer feedback</span></span></li>
      </ol>
      <figcaption>How the parts connect. Providers and runtime details are left out until confirmed.</figcaption>
    </figure>

    <details class="notes">
      <summary>Technical notes</summary>
      <p>
        [How background jobs are queued and retried, how session state is stored, and how speech results are matched
        to the right answer.]
      </p>
    </details>
  </CaseSection>

  <CaseSection id="decisions" number="04" title="Decisions and tradeoffs">
    <Decision
      title="Bring the role into the session first"
      decision="[How résumé and job context shape questions and follow-ups]"
      tradeoff="[What this cost, such as setup time before practice]"
    />
    <Decision
      title="Show listening, processing and recovery"
      decision="[How each session state is shown, and what happens when a step fails]"
      tradeoff="[What was simplified or deferred]"
    />
  </CaseSection>

  <CaseSection id="outcomes" number="05" title="Outcomes">
    <Outcomes
      items={[
        {
          label: 'Evidence',
          text: 'A live product anyone can try, and a public sample report showing the feedback format.',
        },
        { label: 'Not yet measured', text: 'Usage and effect on interview results. No figures are claimed here.' },
      ]}
    />
  </CaseSection>
</CaseStudyLayout>

<style>
  .flow {
    margin-top: 48px;
  }

  .flow > ol {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
    margin: 0;
    padding: 28px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 15px;
    line-height: 1.4;
  }

  /* each step carries the arrow to the next one */
  .flow > ol > li {
    display: flex;
    flex: 1 1 140px;
    align-items: center;
    gap: 12px;
  }

  .flow > ol > li:not(:last-child)::after {
    content: '→';
    color: var(--muted);
  }

  .flow > ol > li.group {
    flex: 1.3 1 170px;
  }

  .node {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    align-self: stretch;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
  }

  .node span {
    color: var(--muted);
  }

  .key {
    border-color: var(--ink);
  }

  .group ul {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group .node {
    padding: 9px 14px;
  }

  strong {
    font-weight: 600;
  }

  .flow figcaption {
    margin-top: 10px;
    font-size: 15px;
    color: var(--muted);
  }

  .notes {
    max-width: 680px;
    margin-top: 24px;
    border-block: 1px solid var(--line);
  }

  .notes summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding-block: 12px;
    font-size: 17px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .notes summary::-webkit-details-marker {
    display: none;
  }

  .notes summary::after {
    content: '+';
    font-size: 22px;
    line-height: 1;
    color: var(--accent);
  }

  .notes[open] summary::after {
    content: '−';
  }

  .notes p {
    padding-bottom: 20px;
    font-size: 16px;
  }

  @media (max-width: 47.99rem) {
    .flow {
      margin-top: 28px;
    }

    .flow > ol {
      flex-direction: column;
      gap: 6px;
      padding: 16px;
    }

    .flow > ol > li {
      flex: none;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
    }

    .flow > ol > li:not(:last-child)::after {
      content: '↓';
      text-align: center;
    }

    .node {
      padding: 10px 12px;
    }

    .flow figcaption {
      font-size: 13px;
    }

    .notes summary {
      font-size: 16px;
    }

    .notes p {
      font-size: 15px;
    }
  }
</style>
