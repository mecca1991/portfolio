---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Wilfred Chetat · Senior Backend Engineer"
  description="Senior backend engineer in Dubai building reliable Python systems and AI-powered products."
>
  <main id="main" class="container hero">
    <p class="eyebrow">Senior Backend Engineer · Dubai, UAE</p>
    <h1 class="display">Building reliable backend systems and AI-powered products.</h1>
    <p class="lede">Site under construction.</p>
  </main>
</BaseLayout>

<style>
  .hero {
    padding-block: 72px 64px;
  }

  .eyebrow {
    margin-bottom: 20px;
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  h1 {
    max-width: 14ch;
    font-size: var(--text-h1);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .lede {
    margin-top: 28px;
    color: var(--muted);
  }
</style>
