---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="Wilfred Chetat · Senior Backend Engineer"
  description="Senior backend engineer in Dubai building reliable Python systems and AI-powered products."
>
  <Header />
  <main id="main">
    <Hero />

    <section class="glance" aria-label="At a glance">
      <dl class="container">
        <div>
          <dt>Currently</dt>
          <dd>Senior Backend Engineer, UXE Security Solutions, since Sep 2024</dd>
        </div>
        <div>
          <dt>Experience</dt>
          <dd>6+ years across payments, data systems, video analytics and AI</dd>
        </div>
        <div>
          <dt>Works on</dt>
          <dd>Employed roles and freelance client projects</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>English, French</dd>
        </div>
      </dl>
    </section>

    <SelectedWork />

    <ContactSection
      title="Tell me what you’re building."
      intro="For an engineering role or a freelance project involving Python backends, integrations, data workflows or AI, send a short outline of what you need."
      footer
    />
  </main>
</BaseLayout>

<style>
  .glance {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
    padding-block: 24px;
    font-size: 16px;
    line-height: 1.45;
  }

  dt {
    font-size: 14px;
    color: var(--muted);
  }

  dd {
    margin-top: 4px;
  }

  /* the phone design leaves this strip out */
  @media (max-width: 47.99rem) {
    .glance {
      display: none;
    }
  }
</style>
