---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import Experience from '../components/Experience.astro';
import Experiments from '../components/Experiments.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="Wilfred Chetat · Senior Software Engineer"
  description="Senior software engineer who builds products end to end, across payments, data systems, video analytics and AI."
>
  <Header />
  <main id="main">
    <Hero />
    <Facts />
    <Projects />
    <Stack />
    <Experience />
    <Experiments />
    <ContactSection
      title="Tell me what you’re"
      emphasis="building."
      intro="For an engineering role involving backend systems, integrations, data workflows or AI, send a short outline of what you need."
      footer
    />
  </main>
</BaseLayout>
