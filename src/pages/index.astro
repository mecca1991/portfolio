---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experiments from '../components/Experiments.astro';
import WritingList from '../components/WritingList.astro';
import About from '../components/About.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="Wilfred Chetat · Senior Software Engineer"
  description="Senior software engineer who builds products end to end, across payments, data systems, video analytics and AI."
>
  <Header />
  <main id="main">
    <Hero />
    <SelectedWork />
    <Experiments />
    <WritingList />
    <About />

    <ContactSection
      title="Tell me what you’re building."
      intro="For an engineering role or a freelance project, whether it’s a backend, an integration, a data workflow or an AI feature, send a short outline of what you need."
      footer
    />
  </main>
</BaseLayout>

